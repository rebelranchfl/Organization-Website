:root{--cream:#f8f3ff;--paper:#fbf8ff;--ink:#271b31;--muted:#594b61;--purple:#5b258f;--purple-dark:#34105b;--purple-2:#25043f;--lavender:#9352c8;--teal:#0397a4;--aqua:#55d7d1;--pink:#f04b98;--gold:#f7c94c;--orange:#f59b45;--green:#247a55;--red:#9c2547;--line:rgba(91,37,143,.17);--shadow:0 18px 55px rgba(48,39,52,.12);--radius:20px;--rainbow:linear-gradient(135deg,#f04b98 0%,#ff756d 20%,#f7c94c 43%,#b7d957 65%,#55d7d1 100%);--primary:linear-gradient(135deg,#f04b98 0%,#ff756d 52%,#f7c94c 100%)}
.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 10% 3%,#f8d9e5 0,transparent 25rem),radial-gradient(circle at 95% 30%,#d6f4f3 0,transparent 24rem),var(--cream);color:var(--ink);font:16px/1.55 "Segoe UI",ui-sans-serif,system-ui,-apple-system,Roboto,Arial,sans-serif}button,input,select,textarea{font:inherit}button,a{-webkit-tap-highlight-color:transparent}a{color:inherit}.skip-link{position:fixed;z-index:100;top:8px;left:8px;transform:translateY(-150%);padding:10px 14px;background:#fff;color:var(--purple);border:2px solid var(--purple);border-radius:8px}.skip-link:focus{transform:none}.app-shell{display:flex;align-items:flex-start;min-height:100vh}.sidebar{position:sticky;top:0;flex:none;width:252px;height:100vh;display:flex;flex-direction:column;padding:20px 14px;background:radial-gradient(circle at 85% 8%,rgba(255,255,255,.5) 0 1px,transparent 2px),radial-gradient(circle at 60% 22%,rgba(255,255,255,.4) 0 1px,transparent 2px),radial-gradient(circle at 25% 15%,rgba(255,255,255,.35) 0 1px,transparent 2px),radial-gradient(circle at 75% 60%,rgba(255,255,255,.3) 0 1px,transparent 2px),radial-gradient(circle at 30% 75%,rgba(255,255,255,.3) 0 1px,transparent 2px),radial-gradient(circle at 15% 45%,rgba(255,255,255,.25) 0 1px,transparent 2px),linear-gradient(180deg,#1a0f33,#0e0720);color:#fff;overflow-y:auto;z-index:25}.sidebar .brand{display:flex;align-items:center;gap:9px;padding:6px 8px 22px;text-decoration:none;white-space:nowrap}.sidebar .brand .brand-mark{color:var(--gold);font-size:1.5rem}.sidebar .brand .brand-word{display:grid;line-height:1.02;font-size:1.05rem;font-weight:1000;letter-spacing:-.01em}.sidebar .brand .brand-word b{background:var(--rainbow);-webkit-background-clip:text;background-clip:text;color:transparent;font-style:normal}.cs-merch-promo{display:flex;align-items:center;justify-content:center;gap:6px;margin:0 8px 16px;padding:9px 10px;border-radius:12px;background:var(--rainbow);color:#1d0637;font-weight:900;font-size:.78rem;text-align:center;text-decoration:none}.cs-merch-promo:hover,.cs-merch-promo:focus-visible{filter:brightness(1.06)}.primary-nav{display:flex;flex-direction:column;gap:4px;flex:1}.primary-nav a{display:flex;align-items:center;gap:11px;padding:8px 10px;border-radius:12px;text-decoration:none;font-weight:800;font-size:.92rem;color:#c9baE0}.primary-nav a .nav-icon{width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;border-radius:50%;font-size:1rem;flex:none;background:rgba(255,255,255,.12);color:#fff}.primary-nav a:hover,.primary-nav a:focus-visible{background:rgba(255,255,255,.09);color:#fff}.primary-nav a[aria-current="page"]{background:linear-gradient(120deg,var(--purple),var(--lavender));color:#fff;box-shadow:0 8px 20px rgba(91,37,143,.5)}.primary-nav a[aria-current="page"] .nav-icon{background:rgba(255,255,255,.22)}.nav-group{margin:14px 0 2px;padding-top:12px;font-size:.68rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#8a7a9e;border-top:1px solid rgba(255,255,255,.14)}.account-actions{display:flex;flex-direction:column;gap:7px;padding-top:14px;margin-top:14px;border-top:1px solid rgba(255,255,255,.16)}.account-chip{display:flex;align-items:center;gap:10px;padding:6px 8px 12px}.user-avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--gold);color:var(--purple-dark);font-weight:900;flex:none}.account-chip-text{display:grid;line-height:1.3;min-width:0}.account-chip-text strong{color:#fff;font-size:.86rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.account-chip-text small{color:#b8a9c9;font-size:.72rem}.account-actions a,.account-actions button{border-color:rgba(255,255,255,.32);background:transparent;color:#d9cdea}.account-actions a:hover,.account-actions a:focus-visible,.account-actions button:hover,.account-actions button:focus-visible{background:rgba(255,255,255,.09);color:#fff}#signout{border:0;background:linear-gradient(135deg,var(--teal),var(--aqua));color:#fff;font-weight:900}#signout:hover,#signout:focus-visible{filter:brightness(1.08)}.mobile-topbar{display:none}.menu-toggle{display:none}.shell{flex:1;min-width:0;width:min(1160px,100%);margin:0 auto;padding:32px clamp(16px,3vw,40px) 80px}.journey-panel{margin-top:0;position:sticky;top:.5rem;z-index:5}
.journey-summary-bar{margin:-4px -4px 8px}
.journey-toggle{display:flex;align-items:center;gap:10px;width:100%;padding:8px 10px;border:0;border-radius:10px;background:transparent;cursor:pointer;font:inherit;text-align:left}
.journey-toggle:hover,.journey-toggle:focus-visible{background:rgba(101,41,154,.06)}
.journey-summary-stage{font-weight:900;color:var(--purple);white-space:nowrap}
.journey-summary-progress{flex:1;height:8px;border-radius:999px;background:#eee5f7;overflow:hidden}
.journey-summary-progress span{display:block;height:100%;background:var(--rainbow)}
.journey-toggle-icon{transition:transform .18s ease}
.journey-panel.is-collapsed .journey-toggle-icon{transform:rotate(-90deg)}
.journey-panel.is-collapsed .journey-panel-body{display:none}
.project-picker-row{display:flex;gap:10px;overflow-x:auto;padding-bottom:6px;margin-bottom:14px}
.mini-project-card{flex:0 0 auto;width:220px;display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--line);border-radius:12px;background:var(--paper);cursor:pointer;font:inherit;text-align:left}
.mini-project-card:hover,.mini-project-card:focus-visible{border-color:var(--pink)}
.mini-project-art{flex:0 0 auto;width:48px;height:48px;border-radius:8px;overflow:hidden;background:var(--cream)}
.mini-project-art img{width:100%;height:100%;object-fit:cover}
.mini-project-body{min-width:0}
.mini-project-body strong{display:block;font-size:.86rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--ink)}
.mini-project-body small{color:var(--pink);font-weight:800}
.stage-focus-panel .stage-prompt-question{font-size:1.05rem;font-weight:750;color:var(--ink);margin:8px 0 16px}
@media(max-width:640px){.journey-panel{top:0}}.journey-track{display:flex;align-items:flex-start;gap:0;overflow-x:auto;padding:10px 2px 4px}.journey-stage{display:flex;flex-direction:column;align-items:center;gap:6px;min-width:100px;text-align:center;opacity:.5}.journey-stage.is-current,.journey-stage.is-done{opacity:1}.journey-dot{width:44px;height:44px;display:grid;place-items:center;border-radius:50%;background:#e4dde7;color:#fff;font-weight:900;font-size:1.05rem}.journey-stage strong{font-size:.85rem;color:var(--ink)}.journey-stage small{color:var(--muted);font-size:.72rem}.journey-line{flex:1;min-width:16px;height:3px;margin-top:22px;background:var(--line)}.stage-dream .journey-dot{background:var(--purple)}.stage-plan .journey-dot{background:var(--teal)}.stage-make .journey-dot{background:var(--green)}.stage-capture .journey-dot{background:var(--gold);color:var(--ink)}.stage-share .journey-dot{background:var(--pink)}.stage-grow .journey-dot{background:var(--lavender)}.hidden{display:none!important}.notice{position:sticky;z-index:15;top:84px;margin:0 0 16px;padding:14px 18px;border-left:5px solid var(--teal);background:#e9f8f7;border-radius:10px;box-shadow:var(--shadow)}.notice.error{border-color:var(--red);background:#fff0f3}.state-card{max-width:720px;margin:9vh auto;padding:clamp(30px,6vw,64px);background:#fff;border:1px solid var(--line);border-radius:28px;text-align:center;box-shadow:var(--shadow)}.state-card h1{font-size:clamp(2rem,6vw,4rem);line-height:1;margin:.2em 0}.loader{width:44px;height:44px;margin:auto;border:5px solid #eadff0;border-top-color:var(--purple);border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(1turn)}}.studio-hero{position:relative;overflow:hidden;padding:clamp(10px,1.4vw,16px) clamp(14px,2.2vw,22px);display:block;color:#fff;background:radial-gradient(circle at 88% 10%,rgba(240,75,152,.28),transparent 24%),linear-gradient(125deg,#1d0637 0%,#2d0e54 55%,#7a3a8f 100%);border-radius:20px;box-shadow:var(--shadow)}.hero-intro h1{max-width:600px;margin:2px 0 4px;font-size:clamp(1.15rem,1.8vw,1.5rem);line-height:1.04;letter-spacing:-.02em}.hero-intro h1 .line{display:block}.hero-intro p{max-width:520px;margin:0 0 8px;font-size:.86rem;color:#e7dcf0}.hero-banner{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:12px 20px;margin-bottom:14px;border-radius:14px;background:var(--primary);color:var(--ink);box-shadow:0 8px 18px rgba(240,75,152,.25)}.hero-banner-copy{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;min-width:0}.hero-banner-copy strong{font-size:.95rem;white-space:nowrap}.hero-banner-copy span{font-size:.85rem;color:var(--ink);opacity:.85}.hero-banner .button{flex:none}.hero-cta{border:0;background:var(--primary);color:var(--ink);box-shadow:0 10px 24px rgba(240,75,152,.35)}.hero-cta:hover,.hero-cta:focus-visible{filter:brightness(1.06)}.hero-note{margin-top:16px;color:#ffd76a;font-size:1rem;font-weight:800}.hero-card{width:min(100%,30rem);margin-inline:auto;padding:.85rem;background:rgba(255,255,255,.94);border:1px solid rgba(255,255,255,.35);border-radius:1.65rem;box-shadow:var(--shadow)}.hero-card img{width:100%;display:block;border-radius:1.2rem;box-shadow:0 14px 38px rgba(34,13,53,.2);margin-bottom:14px}.hero-card-copy{color:var(--ink);padding:0 4px 4px}.hero-card-copy h3{margin:0 0 8px;font-size:1.35rem;line-height:1.15}.hero-card-copy p{margin:0 0 16px;color:var(--muted);font-size:.92rem;line-height:1.5}.hero-card.hero-card-solo{padding:30px 24px;text-align:center}.hero-card.hero-card-solo .hero-card-eyebrow,.hero-card.hero-card-solo .hero-card-copy p{max-width:360px;margin-inline:auto;margin-bottom:14px}.rainbow{background:var(--rainbow);-webkit-background-clip:text;background-clip:text;color:transparent}.hero-stats{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 10px}.hero-stat{display:inline-flex;align-items:center;gap:8px;padding:12px 18px;border-radius:14px;background:rgba(255,255,255,.16);backdrop-filter:blur(6px);color:#fff;font-weight:850;font-size:1.05rem}.hero-stat strong{font-size:1.35rem}.hero-stat-icon{font-size:1.3rem;line-height:1}.stat-points .hero-stat-icon{color:var(--gold)}.stat-streak .hero-stat-icon{color:#ff9a5c}.stat-badge .hero-stat-icon{color:var(--pink)}section.achievement-panel{display:flex;gap:18px;align-items:flex-start;margin-top:18px;background:linear-gradient(135deg,#fff4c9,#ffe3ee)}.badge-medal{flex:none;width:52px;height:52px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--pink));color:#fff;font-size:1.5rem;box-shadow:0 8px 18px rgba(240,75,152,.35)}.achievement-body{flex:1;min-width:0}.achievement-choices{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px}.achievement-choice{display:flex;flex-direction:column;gap:8px;padding:16px;background:rgba(255,255,255,.65);border-radius:14px}.achievement-choice strong{color:var(--ink);font-size:.95rem}.achievement-choice span{flex:1;color:var(--muted);font-size:.82rem;line-height:1.45}.achievement-choice .button{align-self:flex-start}.app-footer{text-align:center;padding:26px 16px 44px}.footer-tagline{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;font-size:1.15rem}.tag-brand{color:var(--purple)}.tag-rainbow{background:var(--rainbow);-webkit-background-clip:text;background-clip:text;color:transparent}.tag-possibility{color:var(--teal);font-weight:800}.footer-by{margin-top:6px;color:var(--muted);font-size:.82rem;font-weight:800}.eyebrow{margin:0 0 8px;color:var(--teal);font-size:.78rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.studio-hero .eyebrow{color:#8ee6e7;border-left:.3rem solid #61e5f0;padding-left:.7rem}.hero-art{z-index:1;display:grid;gap:6px;justify-items:end;transform:rotate(-6deg)}.hero-art span{padding:3px 10px;background:#fff;color:var(--purple);font-size:clamp(1.4rem,4vw,3rem);font-weight:950;letter-spacing:.04em;box-shadow:7px 7px 0 var(--pink)}.view-tools{display:flex;justify-content:space-between;align-items:center;gap:16px;margin:18px 0;padding:10px;background:rgba(255,255,255,.8);border:1px solid var(--line);border-radius:14px}.segmented{display:flex;flex-wrap:wrap;gap:6px}.segmented button{padding:9px 14px;border:0;border-radius:8px;background:transparent;color:var(--muted);font-weight:850}.segmented button[aria-pressed="true"]{background:var(--purple);color:#fff}.creator-picker{display:flex;align-items:center;gap:9px;font-weight:800;white-space:nowrap}.creator-picker select{max-width:190px}.onboarding{position:relative;margin:18px 0;padding:26px;background:#fff4c9;border:1px solid #e9ca55;border-radius:var(--radius)}.onboarding h2{margin:0 0 18px}.onboarding>.icon-button{position:absolute;right:14px;top:14px}.step-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.step-card{padding:14px;background:#fffdf7;border-radius:12px;border-top:3px solid var(--purple)}.step-card:nth-child(2){border-top-color:var(--teal)}.step-card:nth-child(3){border-top-color:var(--pink)}.step-card:nth-child(4){border-top-color:#c99400}.step-card strong{display:block;color:var(--purple)}.step-card:nth-child(2) strong{color:var(--teal)}.step-card:nth-child(3) strong{color:var(--pink)}.step-card:nth-child(4) strong{color:#a9820a}.screen-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:42px 0 20px}.screen-heading h2{margin:0;font-size:clamp(2rem,5vw,3.3rem);line-height:1}.screen-heading p{max-width:620px;margin:8px 0 0;color:var(--muted)}.layout{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(280px,.75fr);gap:18px}.stack{display:grid;gap:18px;align-content:start}.panel{padding:clamp(20px,3vw,30px);background:linear-gradient(150deg,#f1e9f8 0%,#fbf8ff 55%);border:1px solid var(--line);border-left:6px solid var(--purple);border-radius:var(--radius);box-shadow:var(--shadow)}.stack .panel:nth-of-type(2){border-left-color:var(--teal);background:linear-gradient(150deg,#e2f6f5 0%,#fbf8ff 55%)}.stack .panel:nth-of-type(3){border-left-color:var(--pink);background:linear-gradient(150deg,#fce3ec 0%,#fbf8ff 55%)}.stack .panel:nth-of-type(4){border-left-color:var(--gold);background:linear-gradient(150deg,#fff1c9 0%,#fbf8ff 55%)}.panel-header{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:18px}.panel h2,.panel h3{margin:0}.panel-header p{margin:4px 0 0;color:var(--muted)}.card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.project-card{position:relative;overflow:hidden;border:1px solid var(--line);border-radius:16px;background:var(--paper)}.project-art{position:relative;overflow:hidden;aspect-ratio:16/9;min-height:125px;padding:18px;display:flex;align-items:flex-end;background:linear-gradient(135deg,#d4f1ef,#eee1f6);font-size:2.6rem}.project-art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.project-art.business{background:linear-gradient(135deg,#fff0b8,#f7d7df)}.project-art.website{background:linear-gradient(135deg,#eadcf5,#d0eef4)}.project-body{padding:18px}.project-card h3{font-size:1.2rem}.meta-row,.tag-row,.actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.meta-row{justify-content:space-between;margin:7px 0;color:var(--muted);font-size:.88rem}.tag{padding:4px 10px;border-radius:6px;background:linear-gradient(135deg,var(--purple),#7c3fc2);color:#fff;font-size:.76rem;font-weight:850;text-transform:capitalize}.tag:nth-child(2){background:linear-gradient(135deg,var(--teal),var(--aqua))}.status-badge{display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border-radius:6px;background:#e9f5f2;color:var(--green);font-size:.78rem;font-weight:850;text-transform:capitalize}.status-badge.review{background:#fff3cc;color:#72570c}.status-badge.private{background:#eee7f2;color:var(--purple)}.status-badge.status-completed{background:linear-gradient(135deg,var(--green),#3fae7b);color:#fff}.status-badge.status-in_progress{background:linear-gradient(135deg,var(--teal),var(--aqua));color:#fff}.status-badge.status-not_started{background:#eee7f2;color:var(--purple)}.status-badge.status-archived{background:#efe9ec;color:var(--muted)}.progress{height:10px;margin:12px 0;background:#e8e1e8;border-radius:10px;overflow:hidden}.progress span{display:block;height:100%;background:linear-gradient(90deg,var(--pink),var(--purple));border-radius:inherit}.actions{margin-top:14px}.button,button{min-height:42px;padding:9px 16px;border:0;border-radius:14px;background:linear-gradient(135deg,var(--purple),var(--teal));color:#fff;font-weight:850;text-decoration:none;cursor:pointer;transition:transform .15s ease,filter .15s ease;box-shadow:0 6px 16px rgba(91,37,143,.28)}.button:hover,button:hover,.button:focus-visible,button:focus-visible{filter:brightness(1.08);transform:translateY(-2px)}.button.primary,button.primary{background:var(--primary);color:var(--ink);box-shadow:0 8px 20px rgba(240,75,152,.35)}.button.small,button.small{min-height:32px;padding:5px 12px;font-size:.82rem;border-radius:10px}.button.large,button.large{min-height:52px;padding:13px 24px;font-size:1.05rem;border-radius:16px}.button.primary:hover,button.primary:hover,.button.primary:focus-visible,button.primary:focus-visible{filter:brightness(1.06)}button:disabled{opacity:.55;cursor:not-allowed;transform:none}.icon-button{min-width:42px;padding:5px;background:rgba(91,37,143,.1);color:var(--purple);box-shadow:none;font-size:1.45rem}.icon-button:hover{background:rgba(91,37,143,.18)}.dialog-actions button[value="cancel"]{background:#fff;color:var(--purple);border:2px solid var(--purple);box-shadow:none}.dialog-actions button[value="cancel"]:hover{background:#f0e5f7}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.metric-grid-compact{grid-template-columns:repeat(2,1fr)}.metric{padding:18px;background:linear-gradient(160deg,#a8e8e3,#eafcfb 68%);border:1px solid var(--line);border-top:5px solid var(--teal);border-radius:1rem;box-shadow:0 .5rem 1.4rem rgba(3,151,164,.16)}.metric:nth-child(2){border-top-color:var(--pink);background:linear-gradient(160deg,#f9b8d2,#fdf0f6 68%);box-shadow:0 .5rem 1.4rem rgba(240,75,152,.16)}.metric:nth-child(3){border-top-color:var(--gold);background:linear-gradient(160deg,#fbe08c,#fff8e3 68%);box-shadow:0 .5rem 1.4rem rgba(247,201,76,.2)}.metric:nth-child(4){border-top-color:var(--green);background:linear-gradient(160deg,#a8dab8,#eef8f0 68%);box-shadow:0 .5rem 1.4rem rgba(36,122,85,.16)}.metric span{display:block;color:var(--muted);font-size:.84rem}.metric strong{display:block;margin-top:4px;color:var(--teal);font-size:1.6rem}.metric:nth-child(2) strong{color:var(--pink)}.metric:nth-child(3) strong{color:#a9820a}.metric:nth-child(4) strong{color:var(--green)}.metric small{color:var(--muted)}.soft-panel{padding:16px;background:#f6f0f9;border-radius:12px}.next-action{background:linear-gradient(135deg,#fff4c9,#fff);border-color:#ebcf65}.list{display:grid;gap:11px}.list-item{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:13px;padding:13px 0;border-bottom:1px solid var(--line)}.list-item:last-child{border:0}.list-icon{width:42px;height:42px;display:grid;place-items:center;background:linear-gradient(135deg,var(--teal),var(--aqua));color:#fff;border-radius:12px;font-size:1.3rem}.list-item:nth-child(2n) .list-icon{background:linear-gradient(135deg,var(--pink),#ffb35d)}.list-item:nth-child(3n) .list-icon{background:linear-gradient(135deg,var(--gold),var(--orange));color:var(--ink)}.list-item p,.list-item small{margin:0;color:var(--muted)}.portfolio-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.portfolio-card{min-height:235px;padding:20px;display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(145deg,#d8f2f0,#f8d9e5);border-radius:18px}.portfolio-card:nth-child(even){background:linear-gradient(145deg,#eadcf5,#fff0b8)}.readiness{display:grid;gap:13px}.readiness-row{display:grid;grid-template-columns:1fr auto;gap:8px}.readiness-row .progress{grid-column:1/-1;margin:0}.future-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.future-card{padding:17px;border:1px dashed #b8a9bd;border-radius:12px;background:#faf8fa}.future-card strong{display:block}.future-card span{color:var(--muted);font-size:.86rem}.empty-state{padding:42px 24px;text-align:center;border:2px dashed rgba(91,37,143,.35);border-radius:1.25rem;background:linear-gradient(160deg,#f1e9f8,#fbf8ff 70%)}.empty-icon{display:block;color:var(--pink);font-size:2.4rem;text-shadow:0 0 14px rgba(240,75,152,.45);animation:cs-twinkle 2.6s ease-in-out infinite}@keyframes cs-twinkle{0%,100%{opacity:.55;transform:scale(.85)}50%{opacity:1;transform:scale(1.12)}}@media(prefers-reduced-motion:reduce){.empty-icon{animation:none}}.empty-state h2{margin:6px 0}.empty-state p{max-width:520px;margin:0 auto 18px;color:var(--muted)}dialog{position:relative;width:min(660px,calc(100% - 24px));max-height:90vh;padding:0;border:0;border-radius:20px;box-shadow:0 30px 100px #1d102b66;overflow:hidden}dialog:before{content:"";position:absolute;top:0;left:0;right:0;height:6px;background:var(--rainbow);z-index:1}dialog form{max-height:90vh}dialog::backdrop{background:#24172db8;backdrop-filter:blur(3px)}dialog form{padding:26px;overflow:auto}dialog label{display:grid;gap:6px;margin:14px 0;font-weight:850}dialog label span{color:var(--muted);font-size:.8rem;font-weight:normal}input,select,textarea{width:100%;min-height:44px;padding:10px 12px;border:1px solid #aa9cad;border-radius:8px;background:#fff;color:var(--ink)}textarea{min-height:105px;resize:vertical}dialog fieldset{border:0;padding:0;margin:14px 0}dialog legend{padding:0;margin-bottom:8px;font-weight:850}dialog legend span{color:var(--muted);font-size:.8rem;font-weight:normal}.check-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.check-inline{display:flex!important;align-items:center;gap:8px;margin:0!important;font-weight:700!important}.check-inline input{width:auto;min-height:auto}.dialog-heading,.dialog-actions{display:flex;align-items:center;justify-content:space-between;gap:12px}.dialog-actions{justify-content:flex-end;margin-top:20px}*:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
@media(max-width:1040px){.mobile-topbar{display:flex;align-items:center;justify-content:flex-start;gap:12px;position:sticky;top:0;z-index:20;padding:12px 16px;background:rgba(45,8,73,.94);border-bottom:1px solid rgba(255,255,255,.14);box-shadow:0 .7rem 2rem rgba(24,2,39,.24);backdrop-filter:blur(15px)}.mobile-topbar .brand{display:flex;align-items:center;gap:8px;font-weight:900;text-decoration:none}.mobile-topbar .brand b{background:var(--rainbow);-webkit-background-clip:text;background-clip:text;color:transparent;font-style:normal}.mobile-topbar .brand span{color:var(--gold);font-size:1.3rem}.menu-toggle{display:inline-flex;align-items:center}.sidebar{position:fixed;left:0;top:0;bottom:0;transform:translateX(-100%);transition:transform .25s ease;box-shadow:0 0 0 100vmax rgba(20,10,30,0)}.sidebar.open{transform:translateX(0);box-shadow:0 0 0 100vmax rgba(20,10,30,.45)}.shell{width:100%}.studio-hero{grid-template-columns:1fr}.hero-art{display:none}.metric-grid,.future-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:900px){.layout{grid-template-columns:1fr}}
@media(max-width:780px){.shell{width:min(100% - 22px,1240px);padding-top:20px}.layout{grid-template-columns:1fr}.view-tools{align-items:stretch;flex-direction:column}.creator-picker{justify-content:space-between}.step-grid,.portfolio-grid{grid-template-columns:repeat(2,1fr)}.card-grid{grid-template-columns:1fr}.studio-hero{min-height:auto;border-radius:18px}.screen-heading{align-items:flex-start;flex-direction:column}.panel-header{align-items:flex-start}.list-item{grid-template-columns:auto 1fr}.list-item>.button{grid-column:2}.achievement-panel{flex-direction:column}.achievement-choices{grid-template-columns:1fr}}
@media(max-width:480px){.mobile-topbar{position:relative}.mobile-topbar .brand{font-size:.94rem}.studio-hero{padding:18px 16px}.studio-hero h1{font-size:1.8rem}.segmented{display:grid;grid-template-columns:repeat(2,1fr)}.segmented button{text-align:left}.step-grid,.portfolio-grid,.metric-grid,.future-grid{grid-template-columns:1fr}.panel{padding:18px}.panel-header{display:grid}.panel-header .button,.panel-header button{width:100%}.dialog-actions>*{flex:1}.notice{top:8px}}
.companion-avatar{flex:none;filter:drop-shadow(0 8px 16px rgba(29,6,55,.28))}
.companion-svg{display:block}
.companion-body{flex:1;min-width:0}
.companion-editor-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:24px;align-items:start}
.color-row{display:flex;gap:10px;flex-wrap:wrap;margin:6px 0 14px}
.color-swatch{width:40px;height:40px;min-height:40px;padding:0;flex:none;border-radius:12px;border:3px solid #fff;box-shadow:0 0 0 2px var(--line),0 4px 10px rgba(29,6,55,.14)}
.color-swatch.selected{box-shadow:0 0 0 4px var(--gold),0 4px 10px rgba(29,6,55,.14)}
.color-picker-wrap{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--line);border-radius:14px;background:var(--paper)}
.color-picker-wrap input[type="color"]{width:48px;min-height:48px;padding:4px;flex:none}
.color-picker-wrap label{margin:0!important}
.selected-color-line{display:flex;align-items:center;gap:8px;margin-top:4px;font-size:.82rem;color:var(--muted);font-weight:700}
.selected-color-swatch{display:inline-block;width:16px;height:16px;border-radius:5px;border:1px solid var(--line)}
.companion-preview{display:grid;justify-items:center;gap:10px;padding:22px 16px;text-align:center;background:linear-gradient(150deg,#f1e9f8 0%,#e2f6f5 100%);border:1px solid var(--line);border-radius:18px}
.companion-preview .companion-svg{filter:drop-shadow(0 10px 18px rgba(29,6,55,.22))}
.companion-preview strong{font-size:1.1rem;color:var(--purple-dark)}
.companion-preview .companion-speech{max-width:22rem}
@media(max-width:640px){.companion-editor-grid{grid-template-columns:1fr}}
.companion-speech{position:relative;margin:0;padding:10px 14px;background:#fff;border-radius:12px;color:var(--ink);font-weight:700;box-shadow:0 4px 12px rgba(29,6,55,.1)}
.companion-speech:before{content:"";position:absolute;left:-6px;top:14px;width:12px;height:12px;background:#fff;transform:rotate(45deg)}
.sidebar .brand{position:relative}
.sidebar-sparkle{position:absolute;color:#fff6c6;text-shadow:0 0 12px rgba(255,246,198,.95),0 0 22px rgba(255,201,76,.5);pointer-events:none;animation:sidebar-twinkle 2.6s ease-in-out infinite}
@keyframes sidebar-twinkle{0%,100%{opacity:.45;transform:scale(.75) rotate(0deg)}50%{opacity:1;transform:scale(1.3) rotate(12deg)}}
.screen-heading{position:relative;overflow:visible}
.rrm-account-link{display:flex!important;align-items:center;gap:8px}
.rrm-account-link img{width:20px;height:20px;object-fit:contain;flex:none}
@media(prefers-reduced-motion:reduce){.sidebar-sparkle{animation:none;opacity:.7}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.loader{animation:none}.badge-medal-big{animation:none}}

/* 2026-08-18 companion/journey/badge/card flow fixes */
.journey-stage.is-current .journey-dot{animation:cs-current-pulse 2.2s ease-in-out infinite}
@keyframes cs-current-pulse{0%,100%{box-shadow:0 0 0 4px rgba(240,75,152,.28),0 0 14px rgba(240,75,152,.45)}50%{box-shadow:0 0 0 7px rgba(240,75,152,.14),0 0 20px rgba(240,75,152,.6)}}
.journey-companion-row{display:flex;align-items:center;gap:16px;margin-bottom:18px;padding:16px;background:var(--paper);border-radius:16px}
.journey-companion-character{flex:none;filter:drop-shadow(0 6px 12px rgba(29,6,55,.28));animation:cs-companion-bounce 2.6s ease-in-out infinite}
@keyframes cs-companion-bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.companion-bubble-standalone{flex:1;max-width:none;margin:0;text-align:left}
.companion-bubble-standalone:after{left:-6px;top:22px;bottom:auto;transform:none;border:6px solid transparent;border-right-color:#fff;border-top-color:transparent}
@media(max-width:640px){.journey-companion-row{flex-direction:column;align-items:flex-start}.companion-bubble-standalone:after{left:22px;top:-6px;border:6px solid transparent;border-bottom-color:#fff;border-right-color:transparent}}
.companion-help-note{margin:8px 0 0;color:var(--muted);font-size:.78rem;font-weight:700}
@media(max-width:640px){.companion-speech-bar{flex-direction:column;align-items:flex-start}.companion-speech-bar>button{align-self:stretch}}
.achievement-panel-hero{position:relative;overflow:visible;padding:clamp(26px,4vw,38px);border-left-width:10px;box-shadow:0 20px 60px rgba(240,75,152,.28)}
.badge-medal-big{width:88px;height:88px;font-size:2.5rem;box-shadow:0 12px 28px rgba(240,75,152,.45);animation:cs-badge-pop .6s cubic-bezier(.34,1.56,.64,1) both}
@keyframes cs-badge-pop{0%{transform:scale(.4) rotate(-14deg);opacity:0}70%{transform:scale(1.12) rotate(4deg);opacity:1}100%{transform:scale(1) rotate(0)}}
.achievement-panel-hero h2{font-size:clamp(1.5rem,3vw,2rem)}
.art-favorite{position:absolute;left:10px;bottom:10px;min-height:34px;height:34px;padding:0 12px 0 10px;display:inline-flex;align-items:center;gap:6px;border-radius:999px;background:#fff;color:var(--purple-dark);font-size:.9rem;font-weight:800;box-shadow:0 4px 12px rgba(29,6,55,.28)}
.art-favorite span{font-size:.76rem}
.art-favorite:hover,.art-favorite:focus-visible{background:#fff;transform:translateY(-1px);filter:brightness(.97)}
.art-favorite.is-favorite{background:linear-gradient(135deg,var(--pink),var(--gold));color:#fff}
.art-favorite.is-favorite:hover,.art-favorite.is-favorite:focus-visible{filter:brightness(1.06)}
.project-art-filler{background:radial-gradient(circle at 20% 20%,rgba(255,255,255,.55) 0,transparent 45%),radial-gradient(circle at 82% 70%,rgba(255,255,255,.35) 0,transparent 40%),linear-gradient(135deg,#d4f1ef,#eee1f6)}
.project-art.business.project-art-filler{background:radial-gradient(circle at 20% 20%,rgba(255,255,255,.55) 0,transparent 45%),radial-gradient(circle at 82% 70%,rgba(255,255,255,.35) 0,transparent 40%),linear-gradient(135deg,#fff0b8,#f7d7df)}
.project-art.website.project-art-filler{background:radial-gradient(circle at 20% 20%,rgba(255,255,255,.55) 0,transparent 45%),radial-gradient(circle at 82% 70%,rgba(255,255,255,.35) 0,transparent 40%),linear-gradient(135deg,#eadcf5,#d0eef4)}
.project-art-icon{opacity:.55;text-shadow:0 4px 10px rgba(29,6,55,.15)}
.project-desc{margin:2px 0 0;color:var(--muted);font-size:.86rem;line-height:1.4}
.companion-bubble{max-width:180px;padding:8px 12px;margin-bottom:6px;background:#fff;border-radius:12px;color:var(--ink);font-weight:700;font-size:.78rem;line-height:1.35;text-align:left;box-shadow:0 6px 16px rgba(29,6,55,.18);position:relative}
.companion-bubble:after{content:"";position:absolute;left:50%;bottom:-6px;transform:translateX(-50%);border:6px solid transparent;border-top-color:#fff}
.companion-footer{margin-top:18px;padding-top:14px;border-top:1px dashed var(--line);text-align:right}
.parent-project-notes{margin-top:8px;display:grid;gap:6px}
.parent-project-note{padding:8px 10px;background:var(--paper);border-radius:10px;font-size:.82rem}
.parent-project-note strong{display:block;color:var(--ink)}
.parent-project-note span{color:var(--muted)}
