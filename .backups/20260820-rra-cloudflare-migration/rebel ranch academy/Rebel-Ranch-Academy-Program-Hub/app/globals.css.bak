@import "tailwindcss";
:root{--ink:#171713;--cream:#f2ecdc;--paper:#fbf8ef;--rust:#a84125;--moss:#3e4b36;--gold:#d5a936;--line:#282820}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:Arial,Helvetica,sans-serif}button,a{font:inherit}button{color:inherit}a{color:inherit}.topbar{height:84px;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;border-bottom:2px solid var(--line);background:var(--paper);position:sticky;top:0;z-index:20}.brand{text-decoration:none;display:flex;flex-direction:column;line-height:.88;text-transform:uppercase}.brand>span{font-size:11px;font-weight:900;letter-spacing:.2em;color:var(--rust)}.brand strong{font-family:Georgia,serif;font-size:27px;letter-spacing:.02em}.topbar nav{display:flex;gap:28px;align-items:center}.topbar nav a{font-size:13px;font-weight:800;text-transform:uppercase;text-decoration:none;border-bottom:2px solid transparent;padding:8px 0}.topbar nav a:hover,.topbar nav a:focus{border-color:var(--rust)}.topbar nav b{display:inline-grid;place-items:center;background:var(--rust);color:#fff;width:22px;height:22px;border-radius:50%;margin-left:4px}.hero{min-height:650px;display:grid;grid-template-columns:1.25fr .75fr;gap:7vw;align-items:center;padding:80px 7vw;background:var(--paper);position:relative;overflow:hidden}.hero:before{content:"";position:absolute;width:500px;height:500px;border:2px solid rgba(62,75,54,.16);transform:rotate(18deg);right:-300px;top:80px}.hero-copy{position:relative;z-index:1}.eyebrow{font-size:12px;font-weight:900;letter-spacing:.2em;color:var(--rust);margin:0 0 18px}.hero h1{font-family:Georgia,serif;font-size:clamp(48px,6vw,88px);line-height:.97;letter-spacing:-.045em;max-width:900px;margin:0}.hero h1 em{color:var(--rust);font-weight:400}.lede{font-size:19px;line-height:1.65;max-width:680px;margin:30px 0}.actions{display:flex;gap:12px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;justify-content:center;gap:20px;min-height:52px;padding:0 24px;border:2px solid var(--line);text-decoration:none;font-weight:900;text-transform:uppercase;font-size:12px;letter-spacing:.08em;cursor:pointer}.button.primary{background:var(--ink);color:#fff}.button.primary:hover{background:var(--rust)}.button.secondary{background:transparent}.button.secondary:hover{background:#e7dfcb}.hero-board{background:#d9d0b8;border:2px solid var(--line);padding:42px 38px;transform:rotate(1.5deg);box-shadow:12px 12px 0 var(--moss);position:relative}.tape{width:100px;height:25px;background:rgba(250,239,184,.72);position:absolute;top:-14px;left:calc(50% - 50px);transform:rotate(-4deg)}.hero-board>p{font-size:12px;font-weight:900;letter-spacing:.14em;border-bottom:2px solid var(--line);padding-bottom:14px}.hero-board ul{list-style:none;padding:0;margin:18px 0 26px}.hero-board li{font-family:Georgia,serif;font-size:21px;padding:13px 0;border-bottom:1px dashed #716b5c}.hero-board li span{font-family:Arial,sans-serif;font-size:10px;font-weight:900;color:var(--rust);margin-right:12px}.stamp{display:block;border:4px double var(--rust);color:var(--rust);width:max-content;padding:7px 10px;transform:rotate(-4deg);font-size:13px;letter-spacing:.12em}.manifesto{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:35px;background:var(--moss);color:#fff;padding:27px 7vw;text-align:center}.manifesto strong{font-family:Georgia,serif;font-size:28px;color:#f3d36e}.manifesto p{font-size:13px;text-transform:uppercase;letter-spacing:.1em;font-weight:700}.section{padding:95px 7vw}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:50px;margin-bottom:42px}.section-heading h2,.plan-intro h2,.closing h2{font-family:Georgia,serif;font-size:clamp(38px,5vw,66px);line-height:1;margin:0;letter-spacing:-.035em}.section-heading>p{max-width:420px;line-height:1.7}.track-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:2px solid var(--line);border-left:2px solid var(--line)}.track-card{min-height:250px;text-align:left;background:var(--paper);border:0;border-right:2px solid var(--line);border-bottom:2px solid var(--line);padding:30px;cursor:pointer;transition:.18s}.track-card:hover,.track-card:focus{background:#e6c55f;transform:translate(-4px,-4px);box-shadow:5px 5px 0 var(--ink);z-index:2}.track-card>span{font-size:11px;font-weight:900;color:var(--rust)}.track-card h3{font-family:Georgia,serif;font-size:28px;margin:40px 0 10px}.track-card p{line-height:1.55;color:#4e4d44}.track-card b{display:block;margin-top:24px;text-transform:uppercase;font-size:11px;letter-spacing:.08em}.activities{background:var(--paper);border-top:2px solid var(--line);border-bottom:2px solid var(--line)}.filters{display:flex;flex-wrap:wrap;gap:0;margin-bottom:35px;border:2px solid var(--line);width:max-content;max-width:100%}.filters button{border:0;border-right:1px solid var(--line);background:transparent;padding:12px 16px;font-size:11px;text-transform:uppercase;font-weight:900;cursor:pointer}.filters button:last-child{border-right:0}.filters button.active,.filters button:hover{background:var(--ink);color:#fff}.activity-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.activity-card{border:2px solid var(--line);padding:26px;background:var(--cream);display:flex;flex-direction:column;min-height:330px;position:relative}.activity-card.complete:after{content:"DONE";position:absolute;right:16px;top:50px;color:var(--rust);border:3px solid var(--rust);font-weight:900;padding:5px;transform:rotate(8deg)}.meta{display:flex;justify-content:space-between;gap:10px;font-size:10px;font-weight:900;text-transform:uppercase;color:var(--rust);letter-spacing:.08em}.activity-card h3{font-family:Georgia,serif;font-size:28px;line-height:1.05;margin:36px 0 13px}.activity-card>p{line-height:1.55;color:#555347}.card-actions{margin-top:auto;display:flex;flex-direction:column;border-top:1px solid #9b9688}.card-actions button{border:0;border-bottom:1px solid #9b9688;background:transparent;text-align:left;padding:12px 0;font-weight:900;font-size:12px;text-transform:uppercase;cursor:pointer}.card-actions button:hover,.card-actions button.saved{color:var(--rust)}.plan-section{padding:95px 7vw;background:var(--rust);color:#fff;display:grid;grid-template-columns:.72fr 1.28fr;gap:7vw;align-items:start}.plan-intro>p:last-child{line-height:1.7;max-width:420px}.plan-board{background:var(--paper);color:var(--ink);border:2px solid var(--line);box-shadow:10px 10px 0 var(--ink);padding:32px}.progress{height:8px;background:#d6cfbd}.progress span{display:block;height:100%;background:var(--moss);transition:.3s}.plan-board>p{font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.empty{padding:55px 20px;text-align:center;border:1px dashed #8c887c}.empty strong{font-family:Georgia,serif;font-size:25px}.empty a{font-weight:900;text-transform:uppercase;font-size:11px}.plan-list{list-style:none;padding:0;margin:25px 0 0}.plan-list li{display:grid;grid-template-columns:40px 1fr 35px;gap:12px;align-items:center;border-top:1px solid #999386;padding:14px 0}.check{width:32px;height:32px;border:2px solid var(--ink);background:transparent;cursor:pointer;font-weight:900}.check.checked{background:var(--moss);color:#fff}.plan-title{border:0;background:transparent;text-align:left;font-family:Georgia,serif;font-size:18px;cursor:pointer}.plan-title small{display:block;font-family:Arial,sans-serif;font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:#666;margin-top:5px}.remove{border:0;background:transparent;font-size:25px;cursor:pointer}.closing{text-align:center;padding:110px 6vw;background:#d6bd70}.closing h2{margin-bottom:35px}.closing .button{margin:auto}footer{padding:38px 5vw;background:var(--ink);color:#fff;display:flex;justify-content:space-between;align-items:center;gap:30px}footer p{font-size:11px;text-transform:uppercase;letter-spacing:.1em}.modal-backdrop{position:fixed;inset:0;background:rgba(20,20,15,.72);z-index:50;display:grid;place-items:center;padding:20px}.lesson-modal{width:min(680px,100%);max-height:90vh;overflow:auto;background:var(--paper);border:2px solid var(--line);padding:46px;position:relative;box-shadow:10px 10px 0 var(--gold)}.modal-close{position:absolute;top:12px;right:15px;background:transparent;border:0;font-size:30px;cursor:pointer}.lesson-modal h2{font-family:Georgia,serif;font-size:42px;line-height:1.05;margin:0 0 15px}.lesson-desc{font-size:17px;line-height:1.6}.lesson-modal h3{text-transform:uppercase;font-size:12px;letter-spacing:.12em;margin-top:30px}.lesson-modal ol{padding:0;list-style:none}.lesson-modal li{border-top:1px solid #aaa496;padding:13px 0;font-family:Georgia,serif;font-size:18px}.lesson-modal li span{font-family:Arial,sans-serif;font-size:10px;font-weight:900;color:var(--rust);margin-right:14px}.challenge{background:#e3d2a0;border-left:6px solid var(--rust);padding:18px 22px;margin:25px 0}.challenge strong{text-transform:uppercase;font-size:11px;letter-spacing:.1em}.challenge p{margin-bottom:0;line-height:1.5}
@media(max-width:900px){.hero{grid-template-columns:1fr;padding-top:55px}.hero-board{max-width:520px}.manifesto{grid-template-columns:1fr;gap:3px}.track-grid,.activity-grid{grid-template-columns:repeat(2,1fr)}.plan-section{grid-template-columns:1fr}.topbar nav a:not(:last-child){display:none}.section-heading{display:block}.section-heading>p{margin-top:20px}}
@media(max-width:600px){.topbar{height:70px}.brand strong{font-size:22px}.hero{padding:55px 22px}.hero h1{font-size:47px}.actions{flex-direction:column}.button{width:100%}.hero-board{padding:32px 22px;box-shadow:7px 7px 0 var(--moss)}.section,.plan-section{padding:70px 22px}.track-grid,.activity-grid{grid-template-columns:1fr}.filters{width:100%;display:grid;grid-template-columns:1fr 1fr}.filters button{border-bottom:1px solid var(--line)}.section-heading h2,.plan-intro h2,.closing h2{font-size:42px}.activity-card{min-height:300px}.lesson-modal{padding:40px 24px 24px}.lesson-modal h2{font-size:35px}footer{flex-direction:column;text-align:center}.modal-actions{flex-direction:column}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.track-card,.progress span{transition:none}}
