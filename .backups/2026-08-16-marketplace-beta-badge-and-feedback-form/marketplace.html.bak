<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Rebel Ranch Marketplace — A Digital Farmers Market | Trenton, FL</title>
<meta name="description" content="A free digital farmers market for real local makers, farmers, crafters, tradespeople, and small businesses — curated, local-first, and never open to big-box retailers or resellers.">
<link rel="icon" type="image/png" href="assets/brand/rrm-logo-black.png">
<link rel="stylesheet" href="assets/css/public-surface.css">
<script src="assets/js/public-shell.js" defer></script>
<style>
    :root{
      --bg:#07120A;
      --bg2:#0D1E15;
      --panel:#102315;
      --panel2:#152A18;
      --ink:#F0EDD8;
      --muted:#B9B596;
      --green:#97C459;
      --green2:#4A7C59;
      --gold:#C17F24;
      --gold2:#EF9F27;
      --danger:#C24A31;
      --shadow:0 18px 55px rgba(0,0,0,.42);
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      color:var(--ink);
      font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      line-height:1.5;
      overflow-x:hidden;
    }
    a{color:inherit;text-decoration:none}
    .rr-page{min-height:100vh;position:relative;isolation:isolate}

    .hero{width:min(1160px,92vw);margin:0 auto;padding:clamp(3rem,7vw,5.5rem) 0 clamp(2.5rem,5vw,4rem)}
    .hero-layout{display:grid;grid-template-columns:1.35fr .8fr;gap:clamp(1.5rem,4vw,3rem);align-items:start}
    .eyebrow{color:var(--gold2);font-weight:800;letter-spacing:.22em;text-transform:uppercase;font-size:12px;margin-bottom:16px}
    h1{font-size:clamp(36px,5.6vw,66px);line-height:1.03;margin:0 0 18px;letter-spacing:-.03em}
    .hero p.lead{font-size:clamp(17px,2.1vw,21px);color:#d7d1b3;max-width:640px;margin:0 0 20px}

    .buttons{display:flex;flex-wrap:wrap;gap:14px;margin-top:8px}
    .btn{padding:14px 22px;border-radius:999px;font-weight:800;border:1px solid var(--green2);background:#142617;color:var(--ink);box-shadow:var(--shadow);transition:.25s transform,.25s background;display:inline-block}
    .btn:hover{transform:translateY(-2px);background:#1b341f}
    .btn.gold{border-color:var(--gold);background:linear-gradient(135deg,#C17F24,#7b4b13);color:#fff7de}

    /* Non-clickable emphasis tags: plain, not pills, so nobody mistakes them for buttons */
    .no-tags{display:flex;flex-wrap:wrap;gap:6px 22px;margin:0 0 22px}
    .no-tag{display:inline-flex;align-items:center;gap:9px;font-weight:700;font-size:14.5px;color:#e8b7a8}
    .no-tag b{color:var(--danger);font-size:16px;font-weight:900}

    /* Hero quick-link card: jumps to the sections below */
    .hero-quicklinks{padding:22px 24px}
    .hero-quicklinks .ql-label{color:var(--gold2);font-weight:800;letter-spacing:.14em;text-transform:uppercase;font-size:12px;margin:0 0 10px}
    .hero-quicklinks a{display:flex;align-items:center;gap:12px;padding:11px 2px;font-weight:800;font-size:14.5px;border-top:1px solid rgba(151,196,89,.16)}
    .hero-quicklinks a:first-of-type{border-top:0}
    .hero-quicklinks a:hover{color:var(--green)}
    .hero-quicklinks a .qi{font-size:17px;flex:0 0 auto}

    .section-head{text-align:center;margin-bottom:clamp(1.75rem,3.5vw,2.75rem)}
    .section-head .eyebrow{margin-bottom:10px}
    .section-head h2{font-size:clamp(30px,4.4vw,54px);line-height:1.06;font-weight:900;margin:0 0 14px;letter-spacing:-.03em}
    .section-head p{max-width:800px;margin:0 auto 10px;color:#c8c2a5;font-size:18px}
    .section-head p:last-child{margin-bottom:0}
    .section-head .no-tags{justify-content:center;margin:18px 0 0}
    .section-head .callout{color:var(--ink);font-weight:800;font-size:20px;max-width:820px}

    .who-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
    .who-grid .full{grid-column:1/-1}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .card h3{margin:0 0 12px;font-size:22px}
    .icon{font-size:26px;margin-bottom:12px}
    .bullets{list-style:none;margin:0;padding:0;display:grid;gap:9px}
    .bullets li{position:relative;padding-left:24px;color:#c7c1a6;font-size:15px;line-height:1.55}
    .bullets li::before{content:"✓";position:absolute;left:0;top:0;color:var(--gold2);font-weight:900}

    /* Expandable "every benefit" card — open by default, the star of the first section */
    .benefits-card{margin-top:8px}
    .benefits-card summary{cursor:pointer;list-style:none;font-size:clamp(18px,2.2vw,22px);font-weight:800;display:flex;align-items:center;justify-content:space-between;gap:12px}
    .benefits-card summary::-webkit-details-marker{display:none}
    .benefits-card summary .chev{color:var(--gold2);font-size:20px;transition:.2s transform;flex:0 0 auto}
    .benefits-card[open] summary .chev{transform:rotate(180deg)}
    .benefits-grid{margin-top:26px;display:grid;grid-template-columns:repeat(2,1fr);gap:24px 32px}
    .benefits-group h4{margin:0 0 12px;font-size:14px;letter-spacing:.1em;text-transform:uppercase;color:var(--gold2)}

    /* Empty-directory / founding-seller placeholder card */
    .founding-card{grid-column:1/-1;text-align:center}
    .founding-card h3{font-size:24px;margin:0 0 10px}
    .founding-card p{color:#c7c1a6;margin:0 0 16px;max-width:560px;margin-left:auto;margin-right:auto}

    /* Seller directory carousel: 3 cards visible at a time, scroll-snap so it
       scales gracefully as more sellers join without needing pagination UI. */
    .carousel{position:relative;display:flex;align-items:center;gap:8px}
    #seller-directory-grid.grid{display:flex;grid-template-columns:none;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none}
    #seller-directory-grid.grid::-webkit-scrollbar{display:none}
    #seller-directory-grid.grid>.card{flex:0 0 calc((100% - 36px)/3);scroll-snap-align:start}
    #seller-directory-grid.grid[data-count="1"]>.card{flex:0 0 100%}
    #seller-directory-grid.grid[data-count="2"]>.card{flex:0 0 calc((100% - 18px)/2)}
    #seller-directory-grid.grid>.founding-card{flex:0 0 100%}
    .carousel-nav{flex:0 0 auto;width:40px;height:40px;border-radius:50%;border:1px solid var(--green2);background:#142617;color:var(--ink);font-size:22px;line-height:1;cursor:pointer}
    .carousel-nav:hover{background:#1b341f}

    @media(max-width:900px){
      .hero-layout{grid-template-columns:1fr}
      .who-grid{grid-template-columns:1fr}
      .grid{grid-template-columns:1fr}
      .benefits-grid{grid-template-columns:1fr}
      #seller-directory-grid.grid>.card{flex:0 0 82%}
    }
</style>
</head>
<body class="rrm-public-rules">
<div class="rr-page">
<main>

  <section class="hero">
    <div class="hero-layout">
      <div>
        <p class="eyebrow">Rebel Ranch Marketplace</p>
        <h1>A Digital Farmers Market for Real Local Makers.</h1>
        <p class="lead">Free to browse. Free to list. Built for real neighbors — never for the businesses that would bury them.</p>
        <div class="no-tags">
          <span class="no-tag"><b>✕</b> Big-Box Retailers</span>
          <span class="no-tag"><b>✕</b> Mass-Market Resellers</span>
          <span class="no-tag"><b>✕</b> Drop-Shippers</span>
        </div>
        <div class="buttons">
          <a class="btn gold" href="marketplace-seller-dashboard.html">Apply as a Seller</a>
          <a class="btn" href="#seller-directory-section">Browse Local Sellers</a>
        </div>
      </div>
      <div class="card hero-quicklinks">
        <p class="ql-label">Why Join?</p>
        <a href="#benefits"><span class="qi">💰</span> $0 Membership. $0 Commission.</a>
        <a href="#benefits"><span class="qi">🛡️</span> Corporations Not Allowed</a>
        <a href="#benefits"><span class="qi">📣</span> Free Visibility &amp; Reach</a>
        <a href="#business-freedom-program"><span class="qi">🧰</span> Real Help When You Need It</a>
        <a href="#sign-up"><span class="qi">📝</span> Apply In Minutes</a>
      </div>
    </div>
  </section>

  <section id="benefits">
    <div class="section-head">
      <p class="eyebrow">The Rebel Ranch Difference</p>
      <h2>No Corporations. No Resellers. Just Neighbors.</h2>
      <p>A true buy-local, sell-local marketplace — built for sole proprietors, homesteaders, local crafters, and young entrepreneurs. Not warehouses three states away.</p>
      <div class="no-tags">
        <span class="no-tag"><b>✕</b> Big-Box Retailers</span>
        <span class="no-tag"><b>✕</b> Mass-Market Resellers</span>
        <span class="no-tag"><b>✕</b> Drop-Shippers</span>
        <span class="no-tag"><b>✕</b> Anyone Who Could Out-Ship or Out-Price You</span>
      </div>
    </div>

    <details class="card benefits-card" open>
      <summary>
        <span>Every Benefit You Get When You Join</span>
        <span class="chev">▾</span>
      </summary>
      <div class="benefits-grid">
        <div class="benefits-group">
          <h4>Cost &amp; Risk</h4>
          <ul class="bullets">
            <li>Free to list — no membership fee, ever</li>
            <li>0% commission — Rebel Ranch Ministries never touches your money</li>
            <li>No website, no e-commerce fees, no payment gateway to set up</li>
            <li>Use whatever already works for you — PayPal, Venmo, Cash App, Zelle, cash, and more</li>
          </ul>
        </div>
        <div class="benefits-group">
          <h4>Visibility &amp; Trust</h4>
          <ul class="bullets">
            <li>A permanent, searchable listing instead of a one-time festival table</li>
            <li>Borrowed trust — a Rebel Ranch Ministries–approved listing carries more weight than a random online post</li>
            <li>Borrowed reach — tap into an audience you didn't have to build from zero</li>
            <li>Buyers can find you by category and by region</li>
          </ul>
        </div>
        <div class="benefits-group">
          <h4>Protection</h4>
          <ul class="bullets">
            <li>No large retailers or mass-market resellers allowed in — ever</li>
            <li>No shipping required — local pickup and delivery is the norm here, not a disadvantage</li>
            <li>Private messaging — buyers reach you without your personal number or email going public</li>
            <li>Minors are protected — parent or guardian approval required every step</li>
          </ul>
        </div>
        <div class="benefits-group">
          <h4>Room to Grow</h4>
          <ul class="bullets">
            <li>Need help today, not someday? The Business Freedom Program gives you real, hands-on implementation help — donated so it's accessible, not just advice</li>
            <li>Every dollar spent here stays local — strengthening the community you're already part of</li>
          </ul>
        </div>
      </div>
    </details>
  </section>

  <section id="who-its-for">
    <div class="section-head">
      <p class="eyebrow">Who It's For</p>
      <h2>Built Around Real Local Work</h2>
    </div>
    <div class="who-grid">
      <div class="card">
        <div class="icon">🛠️</div>
        <h3>Local Trades</h3>
        <ul class="bullets">
          <li>Fencing, HVAC, electrical, lawn care, cleaning, repair — real, hands-on local work</li>
          <li>Free listing, $0 commission — Rebel Ranch Ministries never touches your money</li>
          <li>Approved-only directory, so buyers trust who they call</li>
        </ul>
      </div>
      <div class="card">
        <div class="icon">🏪</div>
        <h3>Local Businesses</h3>
        <ul class="bullets">
          <li>A permanent, searchable home — not a one-time event table</li>
          <li>Free listing, $0 commission — Rebel Ranch Ministries never touches your money</li>
          <li>Approved-only directory, so buyers trust what they find</li>
        </ul>
      </div>
      <div class="card">
        <div class="icon">🎂</div>
        <h3>Local Crafters, Makers &amp; Bakers</h3>
        <ul class="bullets">
          <li>Handmade goods, baked goods, and side projects — a real, professional listing</li>
          <li>No website to build or pay for — the free front door, no barrier to start</li>
          <li>Minors listed only with a parent or guardian's approval</li>
        </ul>
      </div>
      <div class="card">
        <div class="icon">🌾</div>
        <h3>Local Homesteads</h3>
        <ul class="bullets">
          <li>Produce, eggs, meat, honey — real homestead goods, found and trusted</li>
          <li>No shipping required — local pickup and delivery is the norm here</li>
          <li>The same free, vetted, zero-commission access as every other seller</li>
        </ul>
      </div>
      <div class="card">
        <div class="icon">⚙️</div>
        <h3>Side-Gigs</h3>
        <ul class="bullets">
          <li>Side hustles, side-work, and everything in between</li>
          <li>If you're small, if you're local, this is for you</li>
          <li>Same free listing, same approval, same protection from big competitors</li>
        </ul>
      </div>
      <div class="card">
        <div class="icon">🍋</div>
        <h3>Young Entrepreneurs</h3>
        <ul class="bullets">
          <li>Lemonade, boba, cutting grass — real summer money, real experience</li>
          <li>Saving for a car, school events, clubs, whatever the goal — this is for you</li>
          <li>All minor accounts require parent or guardian approval, every step</li>
        </ul>
      </div>
      <div class="card full">
        <div class="icon">🤝</div>
        <h3>The Community</h3>
        <ul class="bullets">
          <li>Every purchase stays local instead of leaking to a national chain</li>
          <li>Easy access to the real goods and services you actually need — not just a way to keep money local, but a way to find it in the first place</li>
          <li>A vetted directory neighbors can actually trust</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="rebel-ranch-store">
    <div class="section-head">
      <p class="eyebrow">Official Ministry Merchandise</p>
      <h2>Shop the Rebel Ranch Store</h2>
      <p>Looking for Rebel Ranch Ministries shirts, hats, hoodies, bags, cups, tanks, sweaters, and more? Our official merchandise has its own store and helps support the mission.</p>
      <p class="callout">The Rebel Ranch Store is operated by Rebel Ranch Ministries and is separate from the independent local sellers listed in the Marketplace directory.</p>
      <div class="buttons" style="justify-content:center">
        <a class="btn gold" href="merch.html">Shop Rebel Ranch Merchandise</a>
      </div>
    </div>
  </section>

  <section id="business-freedom-program">
    <div class="section-head">
      <p class="eyebrow">Beyond Visibility</p>
      <h2>Need Help Right Now, Not Just a Listing?</h2>
      <p>A listing gets you found. But being found isn't always the problem — sometimes the problem is today: a broken process, a leaking budget, a system you haven't had time to build.</p>
      <p class="callout">That's exactly what the Business Freedom Program is for. It brings real, professional-grade business help — the kind most small operators could never otherwise afford — directly to Rebel Ranch Ministries' community.</p>
      <p>These services are donated, at no cost to the ministry, so every dollar you pay goes straight into Rebel Ranch Ministries' programs, not any individual. This isn't advice you have to go figure out yourself — it's implementation, someone building the fix alongside you, so you can get back to running your business.</p>
      <div class="buttons" style="justify-content:center">
        <a class="btn gold" href="index.html#business-freedom">Explore The Business Freedom Program</a>
      </div>
    </div>
  </section>

  <section id="sign-up">
    <div class="section-head">
      <p class="eyebrow">Ready?</p>
      <h2>Apply in Minutes. Be Found Immediately.</h2>
      <p>The directory is opening to its first vetted sellers now. No fees, no fine print — just a short application, a quick review, and you're live in a curated, corporation-free marketplace built specifically for people like you.</p>
      <div class="buttons" style="justify-content:center">
        <a class="btn gold" href="marketplace-seller-dashboard.html">Apply as a Seller</a>
      </div>
    </div>
  </section>

<section id="seller-directory-section" aria-labelledby="seller-directory-heading">
  <div class="section-head">
    <p class="eyebrow" id="seller-directory-eyebrow">Now Accepting Applications</p>
    <h2 id="seller-directory-heading">Accepting Marketplace Applications Now</h2>
    <p id="seller-directory-description">We're reviewing applications for our very first sellers right now. Check back soon — or scroll up and be one of the first ones buyers see.</p>
    <p><a class="btn gold" href="marketplace-directory.html">Browse the Full Searchable Directory →</a></p>
  </div>
  <div class="carousel">
    <button type="button" class="carousel-nav prev" id="seller-directory-prev" aria-label="Previous sellers" hidden>&#8249;</button>
    <div id="seller-directory-grid" class="grid">
      <div class="card founding-card">
        <h3>The First Listing Could Be Yours</h3>
        <p>Apply today and be one of the first sellers buyers see when the directory opens.</p>
        <a class="btn gold" href="marketplace-seller-dashboard.html">Apply as a Seller</a>
      </div>
    </div>
    <button type="button" class="carousel-nav next" id="seller-directory-next" aria-label="More sellers" hidden>&#8250;</button>
  </div>
</section>
<script type="module" src="assets/js/marketplace-directory.js"></script>

</main>
</div>
</body>
</html>
