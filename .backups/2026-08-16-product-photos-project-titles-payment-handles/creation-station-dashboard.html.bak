<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Create, learn, build a portfolio, and track growth in your Creation Station Dashboard.">
  <title>Creation Station Dashboard | Rebel Ranch Ministries</title>
  <link rel="stylesheet" href="assets/css/creation-station-dashboard.css">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to studio content</a>
  <div class="mobile-topbar">
    <a class="brand" href="creation.html" aria-label="Creation Station home"><span aria-hidden="true">✦</span> <b>Creation Station</b></a>
    <button id="menu-toggle" class="menu-toggle button" type="button" aria-expanded="false" aria-controls="app-sidebar">Menu</button>
  </div>

  <div class="app-shell">
    <aside id="app-sidebar" class="sidebar">
      <a class="brand" href="creation.html" aria-label="Creation Station home"><span class="brand-mark" aria-hidden="true">✦</span><span class="brand-word"><b>Creation</b><b>Station</b></span></a>
      <a class="cs-merch-promo" href="merch.html">🎁 Shop Creation Station Merch</a>
      <nav id="primary-nav" class="primary-nav" aria-label="Creation Station">
        <a href="#studio" data-route="studio"><span class="nav-icon" aria-hidden="true" style="background:var(--teal)">⌂</span>Dashboard</a><p class="nav-group">Create</p><a href="#projects" data-route="projects"><span class="nav-icon" aria-hidden="true" style="background:var(--pink)">◇</span>Projects</a><a href="#portfolio" data-route="portfolio"><span class="nav-icon" aria-hidden="true" style="background:var(--purple)">◆</span>Portfolio</a><p class="nav-group">Learn</p><a href="#classes" data-route="classes"><span class="nav-icon" aria-hidden="true" style="background:var(--lavender)">▣</span>Sessions</a><p class="nav-group">Grow</p><a href="#growth" data-route="growth"><span class="nav-icon" aria-hidden="true" style="background:#3a8fd4">↗</span>Growth</a><a href="#website" data-route="website"><span class="nav-icon" aria-hidden="true" style="background:var(--gold);color:var(--ink)">✦</span>Creation Station Studio</a><a href="#parent" data-route="parent"><span class="nav-icon" aria-hidden="true" style="background:#e2578f">♥</span>Parent View</a><a href="#admin" data-route="admin"><span class="nav-icon" aria-hidden="true" style="background:#6c6470">▦</span>Admin</a>
      </nav>
      <div class="account-actions"><div class="account-chip"><span id="user-avatar" class="user-avatar" aria-hidden="true"></span><div class="account-chip-text"><strong id="user-name">Creator</strong><small>Member</small></div></div><button id="kid-mode-toggle" class="hidden" type="button">Enter Kid Mode</button><a href="account.html">RRM Account</a><button id="signout" type="button">Sign out</button></div>
    </aside>

  <main id="main-content" class="shell" tabindex="-1">
    <div id="app-status" class="notice hidden" role="status" aria-live="polite"></div>
    <section id="loading" class="state-card" aria-busy="true"><div class="loader" aria-hidden="true"></div><h1>Opening your Dashboard</h1><p>Gathering the projects, progress, and tools available to you.</p></section>
    <section id="access-state" class="state-card hidden"><p class="eyebrow">Creation Station</p><h1 id="access-title">Sign in to continue</h1><p id="access-copy">Your Dashboard is protected by your Rebel Ranch Ministries account.</p><a id="access-link" class="button primary" href="account.html">Go to My Account</a></section>

    <div id="workspace" class="hidden">
      <div id="hero-card" class="hero-banner"></div>
      <section class="studio-hero" aria-labelledby="welcome">
        <div class="hero-intro">
          <div id="hero-stats" class="hero-stats hidden" aria-label="Creator progress"><span class="hero-stat stat-points"><span class="hero-stat-icon" aria-hidden="true">★</span><strong id="hero-points">0</strong> points</span><span class="hero-stat stat-streak"><span class="hero-stat-icon" aria-hidden="true">▲</span><strong id="hero-streak">0</strong> day streak</span></div>
          <p id="tier" class="eyebrow">Member Dashboard</p>
          <h1 id="welcome"><span class="line">Welcome to your</span><span class="line rainbow">Dashboard</span></h1>
          <p id="hero-copy">Pick up where you left off, make something meaningful, and see how your skills are growing.</p>
          <button id="hero-cta" class="hero-cta" type="button">Start New Project</button>
        </div>
      </section>

      <section class="view-tools" aria-label="Choose a creator">
        <label class="creator-picker" for="creator-filter">Working with <select id="creator-filter"></select></label>
      </section>

      <section id="onboarding" class="onboarding hidden" aria-labelledby="onboarding-title">
        <button id="close-onboarding" class="icon-button" type="button" aria-label="Close onboarding">×</button>
        <p class="eyebrow">Start here</p><h2 id="onboarding-title">Your path through Creation Station</h2><div id="onboarding-steps" class="step-grid"></div>
      </section>

      <div id="screen" tabindex="-1"></div>
    </div>
  </main>
  </div>

  <footer class="app-footer"><div class="footer-tagline"><strong class="tag-brand">Creation Station</strong> <strong class="tag-rainbow">Create. Learn. Promote. Earn.</strong> <span class="tag-possibility">From passion to possibility.</span></div><div class="footer-by">by Rebel Ranch Ministries</div></footer>

  <template id="empty-template"><section class="empty-state"><span class="empty-icon" aria-hidden="true">✦</span><h2></h2><p></p><button class="button primary" type="button"></button></section></template>

  <dialog id="project-dialog" aria-labelledby="project-dialog-title"><form method="dialog" id="project-form"><div class="dialog-heading"><div><p class="eyebrow">New project</p><h2 id="project-dialog-title">Start something new</h2></div><button class="icon-button" value="cancel" formnovalidate aria-label="Close">×</button></div><label>Creator<select id="creator" required></select></label><label>Project<select id="template" required></select></label><div id="template-preview" class="soft-panel"></div><div class="dialog-actions"><button value="cancel" formnovalidate>Cancel</button><button class="primary" id="create-project" value="default">Start project</button></div></form></dialog>
  <dialog id="edit-dialog" aria-labelledby="edit-dialog-title"><form method="dialog" id="edit-form"><div class="dialog-heading"><div><p class="eyebrow">Project progress</p><h2 id="edit-dialog-title">Save your next step</h2></div><button class="icon-button" value="cancel" formnovalidate aria-label="Close">×</button></div><input id="edit-id" type="hidden"><div id="edit-young-gate" class="hidden soft-panel" style="margin-bottom:14px"></div><div id="edit-stage-picker" style="margin-bottom:6px"></div><label>What was the best part, or what went right?<textarea id="reflect-best"></textarea></label><label>What was tricky, or didn't go the way you planned?<textarea id="reflect-tricky"></textarea></label><label>If you did this again, what would you do differently?<textarea id="reflect-change"></textarea></label><label>What did you learn? Would you want to do a project like this again?<textarea id="reflect-learned"></textarea></label><label>Private project file <span>JPEG, PNG, WebP, PDF, or text; 20 MB max</span><input id="edit-file" type="file" accept="image/jpeg,image/png,image/webp,application/pdf,text/plain"></label><div class="dialog-actions" style="justify-content:space-between"><button type="button" id="edit-archive" class="icon-button" style="font-size:.8rem;font-weight:800" title="Archive this project">Archive this project</button><div class="dialog-actions"><button value="cancel" formnovalidate>Cancel</button><button class="primary" id="save-project" value="default">Save progress</button></div></div></form></dialog>
  <dialog id="website-dialog" aria-labelledby="website-dialog-title"><form method="dialog" id="website-form"><div class="dialog-heading"><div><p class="eyebrow">Managed publishing</p><h2 id="website-dialog-title">New Studio request</h2></div><button class="icon-button" value="cancel" formnovalidate aria-label="Close">×</button></div><label>Creator<select id="website-creator" required></select></label><label>Brand or studio name<input id="brand-name" maxlength="120" required></label><label>Creator story<textarea id="brand-story" required></textarea></label><label>Products or services<textarea id="brand-products"></textarea></label><label>Social links <span>One per line</span><textarea id="brand-links"></textarea></label><fieldset><legend>How will buyers pay you? <span>Choose all that apply</span></legend><div class="check-grid"><label class="check-inline"><input type="checkbox" name="payment_methods" value="paypal"> PayPal</label><label class="check-inline"><input type="checkbox" name="payment_methods" value="cashapp"> Cash App</label><label class="check-inline"><input type="checkbox" name="payment_methods" value="zelle"> Zelle</label><label class="check-inline"><input type="checkbox" name="payment_methods" value="cod"> Cash on delivery</label><label class="check-inline"><input id="payment-other-toggle" type="checkbox" name="payment_methods" value="other"> Other</label></div><label id="payment-other-wrap" class="hidden">Tell us more about "Other"<input id="payment-other-note" maxlength="120" placeholder="Example: Venmo, cash in person"></label><label>Payment link <span>Your PayPal.me link or similar — optional, but buyers can pay you directly if you add one</span><input id="payment-link" type="url" placeholder="https://paypal.me/yourname"></label></fieldset><fieldset><legend>How will buyers get their order? <span>Choose all that apply</span></legend><div class="check-grid"><label class="check-inline"><input type="checkbox" name="delivery_methods" value="shipped"> Shipped</label><label class="check-inline"><input type="checkbox" name="delivery_methods" value="mailed"> Mailed</label><label class="check-inline"><input type="checkbox" name="delivery_methods" value="pickup_customer"> Pickup by customer</label><label class="check-inline"><input type="checkbox" name="delivery_methods" value="dropoff_seller"> Drop off by seller</label><label class="check-inline"><input type="checkbox" name="delivery_methods" value="local_meet"> Local meet</label></div></fieldset><fieldset><legend>Parent or guardian approval <span>Required before this request can be submitted</span></legend><label>Parent or guardian full name<input id="website-parent-name" maxlength="120" required></label><label>Relationship to the creator <span>Example: Mother, Father, Guardian</span><input id="website-parent-relationship" maxlength="60" required></label><label class="check-inline"><input id="website-parent-consent" type="checkbox" required> I am the parent or guardian of this creator, and I have reviewed everything entered above. Paid Studio requests go public immediately when submitted — there is no review step. Practice-mode requests stay private until you upgrade. Nothing here is guaranteed to result in sales or income.</label></fieldset><div class="dialog-actions"><button value="cancel" formnovalidate>Cancel</button><button class="primary" value="default">Submit request</button></div></form></dialog>

  <dialog id="session-dialog" aria-labelledby="session-dialog-title"><form method="dialog" id="session-form"><div class="dialog-heading"><div><p class="eyebrow">Admin · Sessions</p><h2 id="session-dialog-title">Schedule a live session</h2></div><button class="icon-button" value="cancel" formnovalidate aria-label="Close">×</button></div><input id="session-id" type="hidden"><label>Title<input id="session-title" maxlength="120" required></label><label>Description<textarea id="session-description"></textarea></label><label>Starts<input id="session-starts" type="datetime-local" required></label><label>Ends <span>Optional</span><input id="session-ends" type="datetime-local"></label><label>Capacity <span>Optional, leave blank for no limit</span><input id="session-capacity" type="number" min="1"></label><label>Meeting link <span>Zoom, Meet, etc.</span><input id="session-meeting" type="url"></label><label>Replay link <span>Add once the session is over, optional</span><input id="session-replay" type="url"></label><label>Registration link <span>PayPal or other payment link — optional, leave blank for free sessions</span><input id="session-registration" type="url"></label><label>Supply list <span>One item per line</span><textarea id="session-supplies"></textarea></label><label class="check-inline"><input id="session-published" type="checkbox"> Published (visible to members now)</label><div class="dialog-actions"><button value="cancel" formnovalidate>Cancel</button><button class="primary" value="default">Save session</button></div></form></dialog>

  <dialog id="product-dialog" aria-labelledby="product-dialog-title"><form method="dialog" id="product-form"><div class="dialog-heading"><div><p class="eyebrow">Studio product</p><h2 id="product-dialog-title">Add a product</h2></div><button class="icon-button" value="cancel" formnovalidate aria-label="Close">×</button></div><input id="product-id" type="hidden"><label>Title<input id="product-title" maxlength="120" required></label><label>Description<textarea id="product-description"></textarea></label><label>Price <span>Free text, e.g. "$16" or "Starting at $8"</span><input id="product-price"></label><label>Photo <span>Optional — JPEG, PNG, or WebP</span><input id="product-file" type="file" accept="image/jpeg,image/png,image/webp"></label><div class="dialog-actions"><button value="cancel" formnovalidate>Cancel</button><button class="primary" value="default">Save product</button></div></form></dialog>

  <dialog id="review-dialog" aria-labelledby="review-dialog-title"><form method="dialog" id="review-form"><div class="dialog-heading"><div><p class="eyebrow">Admin review</p><h2 id="review-dialog-title">Review</h2></div><button class="icon-button" value="cancel" formnovalidate aria-label="Close">×</button></div><div id="review-content" class="soft-panel"></div><label>Admin note <span>Shown to the family if you request changes or decline</span><textarea id="review-note"></textarea></label><div id="review-publish-wrap" class="hidden"><label>Published URL<input id="review-published-url" type="url" placeholder="https://..."></label></div><div class="dialog-actions" style="flex-wrap:wrap;justify-content:flex-start"><button type="button" id="review-approve" class="primary">Approve</button><button type="button" id="review-changes">Request changes</button><button type="button" id="review-reject">Decline</button><button type="button" id="review-publish" class="hidden primary">Mark published</button></div><div class="dialog-actions"><button value="cancel" formnovalidate>Close</button></div></form></dialog>

  <dialog id="pin-dialog" aria-labelledby="pin-dialog-title"><form method="dialog" id="pin-form"><div class="dialog-heading"><div><p class="eyebrow">Kid Mode</p><h2 id="pin-dialog-title">Enter PIN</h2></div><button class="icon-button" value="cancel" formnovalidate aria-label="Close">×</button></div><p id="pin-dialog-copy" class="soft-panel"></p><label>PIN <span>4-6 digits</span><input id="pin-input" type="password" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="off"></label><div class="dialog-actions"><button value="cancel" formnovalidate>Cancel</button><button class="primary" value="default">Continue</button></div></form></dialog>

  <script type="module" src="assets/js/creation-station-app.js"></script>
</body>
</html>
