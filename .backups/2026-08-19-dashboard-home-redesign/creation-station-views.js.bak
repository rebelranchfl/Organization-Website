import {SUPABASE_URL} from './supabase-client.js';
const esc=(v='')=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML};
const studioPublicUrl=path=>path?`${SUPABASE_URL}/storage/v1/object/public/creation-station-studio-public/${path}`:null;
const formatPrice=v=>{const t=(v||'').trim();return t&&/^\d+([.,]\d+)?$/.test(t)?`$${t}`:t};
const status=(v='draft')=>v.replaceAll('_',' ');
const filtered=(state,list,key='creator_id')=>state.creatorId==='all'?list:list.filter(x=>x[key]===state.creatorId);
const creatorName=(state,id)=>state.identity.creators.find(c=>c.id===id)?.display_name||'Creator';
const heading=(eyebrow,title,copy,action='')=>`<header class="screen-heading"><span class="sidebar-sparkle" aria-hidden="true" style="top:-20px;left:0;font-size:1.1rem;animation-delay:.2s">&#10022;</span><span class="sidebar-sparkle" aria-hidden="true" style="top:-16px;right:0;font-size:.75rem;animation-delay:1.3s">&#10022;</span><div><p class="eyebrow">${eyebrow}</p><h2>${title}</h2><p>${copy}</p></div>${action}</header>`;
const empty=(title,copy,action,label)=>`<section class="empty-state"><span class="empty-icon" aria-hidden="true">✦</span><h2>${title}</h2><p>${copy}</p>${label?`<button class="button primary" data-action="${action}">${label}</button>`:''}</section>`;
const projectCard=(state,p)=>{const t=state.data.templates.find(x=>x.id===p.template_id)||{};const asset=(state.data.projectAssets||[]).find(a=>a.project_id===p.id&&a.mime_type?.startsWith('image/'));const imgUrl=asset&&state.assetUrls?.[asset.storage_path];const desc=parseReflection(p.notes).description;return `<article class="project-card"><div class="project-art ${esc(t.category)} ${imgUrl?'':'project-art-filler'}" aria-hidden="true">${imgUrl?`<img src="${esc(imgUrl)}" alt="">`:''}<button class="art-favorite ${p.is_favorite?'is-favorite':''}" data-favorite="${p.id}" aria-pressed="${p.is_favorite?'true':'false'}" aria-label="${p.is_favorite?'Remove favorite':'Add to favorites'}">★ <span>Favorite</span></button></div><div class="project-body"><div class="meta-row"><span class="status-badge status-${esc(p.status)}">${esc(status(p.status))}</span><span>${esc(creatorName(state,p.creator_id))}</span></div><h3>${esc(p.title)}</h3><div class="progress" role="progressbar" aria-label="Project completion" aria-valuenow="${p.completion}" aria-valuemin="0" aria-valuemax="100"><span style="width:${p.completion}%"></span></div><div class="meta-row"><strong>${p.completion}% complete</strong></div>${desc?`<p class="project-desc">${esc(desc)}</p>`:''}<div class="actions"><button class="primary" data-edit="${p.id}">${p.status==='completed'?'View project':'Resume Project'}</button><button class="small" data-archive="${p.id}">Remove from workbench</button></div></div></article>`};
const projectGrid=(state,limit)=>{const ps=filtered(state,state.data.projects).filter(p=>p.status!=='archived').slice(0,limit||999);return ps.length?`<div class="card-grid">${ps.map(p=>projectCard(state,p)).join('')}</div>`:empty('Your first idea starts here','Choose a guided project and the Studio will save your progress privately.','new-project','Start a project')};
const archivedProjects=state=>{const ps=filtered(state,state.data.projects).filter(p=>p.status==='archived');return ps.length?`<section class="panel" style="margin-top:18px"><div class="panel-header"><div><p class="eyebrow">Archive</p><h2>Archived projects</h2></div></div><div class="list">${ps.map(p=>`<article class="list-item"><span class="list-icon" aria-hidden="true">◇</span><div><h3>${esc(p.title)}</h3><p>${p.completion}% complete · ${esc(creatorName(state,p.creator_id))}</p></div><button class="small" data-restore="${p.id}">Restore project</button></article>`).join('')}</div></section>`:''};
const resourceList=(state,items)=>items.length?`<div class="list">${items.map(r=>`<article class="list-item"><span class="list-icon" aria-hidden="true">${r.resource_type==='worksheet'?'▤':'↗'}</span><div><h3>${esc(r.title)}</h3><p>${esc(r.description)}</p><small>${esc(status(r.resource_type))}</small></div>${r.external_url?`<a class="button" href="${esc(r.external_url)}" target="_blank" rel="noopener">Open<span class="sr-only"> ${esc(r.title)}</span></a>`:'<span class="status-badge private">Member file</span>'}</article>`).join('')}</div>`:empty('Resources are being prepared','Published worksheets, downloads, and references for your tier will appear here.','','');
const classList=(state,items)=>items.length?`<div class="list">${items.map(c=>{const reg=state.data.registrations.find(r=>r.class_id===c.id&&(state.creatorId==='all'||r.creator_id===state.creatorId));const upcoming=new Date(c.starts_at)>new Date();const supplies=Array.isArray(c.supply_list)&&c.supply_list.length?esc(c.supply_list.join(', ')):'No supply list yet';const regAction=reg?'<span class="status-badge">Registered</span>':(c.registration_link?`<button class="primary" data-register-class="${c.id}">Register</button>`:'<span class="status-badge review">Not registered</span>');const joinAction=c.meeting_url&&(!c.registration_link||reg)?`<a class="button" href="${esc(c.meeting_url)}" target="_blank" rel="noopener">Join session</a>`:'';return `<article class="list-item"><span class="list-icon" aria-hidden="true">▣</span><div><h3>${esc(c.title)}</h3><p>${new Date(c.starts_at).toLocaleString()}</p>${c.description?`<p>${esc(c.description)}</p>`:''}<small>Supplies: ${supplies} · ${upcoming?'Upcoming':'Replay or attendance record'}</small></div><div class="actions">${joinAction}${regAction}</div></article>`}).join('')}</div>`:empty('No published sessions yet','Upcoming sessions, supply lists, registration status, and replays will appear here.','','');

export const reflectionPrompts=[['description','What are you making? Tell us about it!'],['best','What was the best part, or what went right?'],['tricky','What was tricky, or didn\'t go the way you planned?'],['change','If you did this again, what would you do differently?'],['learned','What did you learn? Would you want to do a project like this again?']];
export const serializeReflection=a=>reflectionPrompts.map(([key,label])=>a[key]?.trim()?`${label}\n${a[key].trim()}`:'').filter(Boolean).join('\n\n');
export const parseReflection=text=>{const out={};if(!text)return out;text.split('\n\n').forEach(part=>{const lines=part.split('\n'),label=lines[0],body=lines.slice(1).join('\n'),found=reflectionPrompts.find(([,l])=>l===label);if(found)out[found[0]]=body});return out};
export const journeyStages=[['Dream It','Imagine big','dream'],['Plan It','Make a plan','plan'],['Make It','Build it up','make'],['Capture It','Show your work','capture'],['Share It','Inspire others','share'],['Grow It','Keep learning','grow']];
export const stageIndexFor=p=>{if(!p||p.status==='not_started')return 0;if(p.status==='completed')return 5;const c=p.completion||0;if(c<=10)return 1;if(c<=40)return 2;if(c<=70)return 3;return 4};
const stageProgressTable=[{status:'not_started',completion:0},{status:'in_progress',completion:5},{status:'in_progress',completion:25},{status:'in_progress',completion:55},{status:'in_progress',completion:85},{status:'completed',completion:100}];
export const stageToProgress=idx=>stageProgressTable[idx]||stageProgressTable[0];

const activityDays=dates=>[...new Set(dates.map(d=>d.slice(0,10)))].sort().reverse();
const dayGap=(a,b)=>Math.round((Date.parse(a)-Date.parse(b))/86400000);
function computeStreak(dates){const days=activityDays(dates);if(!days.length)return 0;const today=new Date().toISOString().slice(0,10);if(dayGap(today,days[0])>5)return 0;let n=1;for(let i=1;i<days.length;i++){if(dayGap(days[i-1],days[i])>5)break;n++}return n}
export function engagement(state){const rows=filtered(state,state.data.activity),points=rows.length,streak=computeStreak(rows.map(r=>r.created_at)),projectsForBadge=filtered(state,state.data.projects),badgeEarned=projectsForBadge.some(p=>p.status==='completed');return {points,streak,badgeEarned}}
function achievementPanel(state,eng){if(!eng.badgeEarned)return'';return `<section class="panel achievement-panel achievement-panel-hero"><span class="sidebar-sparkle" aria-hidden="true" style="top:-14px;left:6%;font-size:1.1rem;animation-delay:.2s">&#10022;</span><span class="sidebar-sparkle" aria-hidden="true" style="top:-10px;right:8%;font-size:.75rem;animation-delay:1.3s">&#10022;</span><span class="badge-medal badge-medal-big" aria-hidden="true">★</span><div class="achievement-body"><p class="eyebrow">First Project Badge</p><h2>You finished your first project!</h2><p>That's one badge earned. Finish another project to keep the collection growing — every finished project counts toward your next one.</p></div></section>`}

export function audience(state){const c=state.identity.creators.find(x=>x.id===state.creatorId)||state.identity.creators[0];if(state.view==='parent')return'parent';if(state.view==='admin')return'admin';if(!c)return'adult';if(c.age_band==='young_6_12')return'young';if(c.age_band==='teen_13_17')return'teen';return'adult'}
export function viewHeroCopy(view){return {projects:{line1:"You're in",line2:'Projects',copy:'Pick up where you left off.'},portfolio:{line1:"You're in",line2:'Portfolio',copy:'Your finished work lives here.'},classes:{line1:"You're in",line2:'Sessions',copy:'Your weekly live Creation Station Club.'},growth:{line1:"You're in",line2:'Growth',copy:"Here's how far you've come."},website:{line1:"You're in your",line2:'Studio',copy:'Manage your Creation Station Studio page.'}}[view]}
export function copyForAudience(a,name){return {young:{line1:'Ready to make something,',line2:`${name}?`,copy:'Choose your next creative step, keep going, and celebrate what you learn.'},teen:{line1:'Build what is yours,',line2:`${name}.`,copy:'Own the process, sharpen your skills, and turn strong work into a portfolio.'},adult:{line1:'Welcome back to your Dashboard,',line2:`${name}.`,copy:'Move your creative work forward while building the portfolio and readiness behind it.'},parent:{line1:'See the growth',line2:'behind the making.',copy:'Support each creator with useful context, clear approvals, and encouraging next steps.'},admin:{line1:'Creation Station',line2:'operations.',copy:'Monitor readiness and review queues without changing the member experience.'}}[a]}

const companionStart=[`Ready when you are — let's start something new together!`,`I've got an idea... do YOU have an idea? Let's start a project!`];
export const companionPhrases={
  dream:{arrival:[`Let's dream up something new! What do you want to make?`,`Ooh, a fresh idea! What are we dreaming up today?`],nudge:[`Tell me what you want to make, and who it's for.`,`What's the big idea? Type it in and let's go!`]},
  plan:{arrival:[`Time to plan it out! What do you need to get started?`,`Let's map this out before we build.`],nudge:[`What supplies do you need, and how long do you think it'll take?`,`What's the plan? Write down what you'll need.`],celebrate:[`You picked an idea — that's the hardest part! On to planning.`]},
  make:{arrival:[`This is the fun part — let's build!`,`Hands on! Let's make it.`],nudge:[`Ran into something tricky? Tell me what happened and what you tried.`,`How's it going? Tell me what's working and what's not.`],celebrate:[`You've got a plan! Now let's go make it real.`]},
  capture:{arrival:[`Don't forget to save proof of your amazing work!`,`Let's capture this moment!`],nudge:[`Take a photo of what you made — before and after if you can!`,`Snap a picture so we don't forget how good this looks.`],celebrate:[`Look at you go! You're really making this.`]},
  share:{arrival:[`Time to tell your story!`,`What should people know about what you made?`],nudge:[`Write about why you made this and what it's for.`,`Tell me the story — what happened while you made it?`],celebrate:[`Got it saved! Now everyone can see what you made.`]},
  grow:{arrival:[`You finished making it! Let's think about what you learned.`],nudge:[`What worked? What would you change next time?`,`What's one thing you'd do differently if you made this again?`],celebrate:[`You told your story — that takes courage!`,`We did it! Project complete. I'm so proud of you.`,`You finished it! What should we dream up next?`]}
};
export const pick=arr=>arr[Math.floor(Math.random()*arr.length)];
export const companionSvg=(color,size=68)=>`<svg class="companion-svg" viewBox="0 0 320 320" width="${size}" height="${size}" role="img" aria-hidden="true"><path d="M58 252c36 18 166 18 204 0" fill="none" stroke="#F7C94C" stroke-width="18" stroke-linecap="round" opacity=".85"/><rect x="83" y="90" width="154" height="142" rx="40" fill="${esc(color)}"/><rect x="100" y="115" width="120" height="74" rx="22" fill="#E8FBF8"/><circle cx="132" cy="150" r="11" fill="#34105B"/><circle cx="188" cy="150" r="11" fill="#34105B"/><path d="M137 171c15 12 31 12 46 0" fill="none" stroke="#F04B98" stroke-width="8" stroke-linecap="round"/><rect x="133" y="52" width="54" height="46" rx="17" fill="#F7C94C"/><path d="M160 52V32" stroke="#fff" stroke-width="8" stroke-linecap="round"/><circle cx="160" cy="25" r="11" fill="#F04B98"/><path d="M82 143H52c-12 0-18 10-18 20v48" fill="none" stroke="#0397A4" stroke-width="18" stroke-linecap="round"/><path d="M238 143h30c12 0 18 10 18 20v48" fill="none" stroke="${esc(color)}" stroke-width="18" stroke-linecap="round"/><path d="M64 208l-18 38M256 208l18 38" stroke="#F7C94C" stroke-width="12" stroke-linecap="round"/><circle cx="46" cy="248" r="13" fill="#F04B98"/><circle cx="274" cy="248" r="13" fill="#F59B45"/></svg>`;
function companionMoment(creatorId,project){
  if(!project)return pick(companionStart);
  const idx=stageIndexFor(project),stageKey=journeyStages[idx][2],phrases=companionPhrases[stageKey];
  const stageStoreKey=`rrm-companion-stage-${creatorId}-${project.id}`,stored=localStorage.getItem(stageStoreKey),lastIdx=stored===null?null:Number(stored);
  localStorage.setItem(stageStoreKey,String(idx));
  if(lastIdx!==null&&idx>lastIdx&&phrases.celebrate)return pick(phrases.celebrate);
  const greetKey=`rrm-companion-greeted-${creatorId}`;
  if(!sessionStorage.getItem(greetKey)){sessionStorage.setItem(greetKey,'1');return pick(phrases.arrival)}
  return pick(phrases.nudge);
}
function journeyCompanionPanel(state){
  const ps=filtered(state,state.data.projects).filter(p=>p.status!=='archived');
  const active=ps.find(p=>p.status==='in_progress')||ps[0]||null;
  const idx=stageIndexFor(active);
  const isYoung=audience(state)==='young';
  const creator=isYoung?(state.identity.creators.find(x=>x.id===state.creatorId)||state.identity.creators[0]):null;
  const companion=creator?(state.data.companions||[]).find(c=>c.creator_id===creator.id):null;
  const name=companion?.companion_name||'Your Companion';
  const color=companion?.color||'#65299a';
  const msg=creator?(companion?companionMoment(creator.id,active):`Name your Creation Companion to get started!`):'';
  const bubbleText=`${companion?.catchphrase?`&ldquo;${esc(companion.catchphrase)}&rdquo; `:''}${esc(msg)}`;
  const companionRow=creator?`<div class="journey-companion-row"><div class="journey-companion-character" aria-hidden="true">${companionSvg(color,64)}</div><div class="companion-bubble companion-bubble-standalone"><strong>${esc(name)}:</strong> ${bubbleText}</div></div>`:'';
  const track=`<div class="journey-track">${journeyStages.map(([label,sub,key],i)=>`<div class="journey-stage stage-${key} ${i===idx?'is-current':''} ${i<idx?'is-done':''}"><span class="journey-dot" aria-hidden="true">${i<idx?'✓':i+1}</span><strong>${label}</strong><small>${sub}</small></div>`).join('<span class="journey-line" aria-hidden="true"></span>')}</div>`;
  const footer=creator?`<div class="companion-footer"><button data-action="edit-companion">${companion?'Customize Companion':'Name your Companion'}</button></div>`:'';
  return `<section class="panel journey-panel" id="journey-panel"><p class="eyebrow">Your Creation Journey</p><h2>${active?esc(active.title):'Start your first project to begin the journey'}</h2>${companionRow}${track}${footer}</section>`;
}
function nextStepsPanel(state,eng){if(!eng.badgeEarned)return'';const readyForStudio=state.identity.tier>=3;const studioAction=readyForStudio?'<button class="button primary" data-action="website-request">Set Up My Studio</button>':'<a class="button primary" href="creation-station-membership.html">Set Up My Studio</a>';return `<section class="panel" style="margin-top:18px"><p class="eyebrow">Next step</p><h2>Ready to run it like a pro?</h2><p>You've got real work to show for it. Here's where to take it from here.</p><div class="achievement-choices"><div class="achievement-choice"><strong>Ready to sell what you made?</strong><span>Go straight to your own Creation Station Studio website.</span>${studioAction}</div><div class="achievement-choice"><strong>Not quite ready yet? That's okay!</strong><span>Keep creating and practicing here.</span><button class="button" data-action="new-project">Keep Practicing</button></div><div class="achievement-choice"><strong>Want help doing it right?</strong><span>Need help with pricing, marketing, listing your product, or setting up your shop the right way? Our business sessions get you ready to launch.</span><a class="button" href="academy-learning-interest.html" target="_blank" rel="noopener">Business Sessions at Academy</a></div></div></section>`}
export function studio(state){const ps=filtered(state,state.data.projects),active=ps.find(p=>p.status==='in_progress'),complete=ps.filter(p=>p.status==='completed').length,eng=engagement(state);return `${heading('Your Dashboard','Make, learn, and keep moving','Your creative home for projects, portfolios, sessions, and the next useful step.')}${achievementPanel(state,eng)}<div class="metric-grid metric-grid-compact"><div class="metric"><span>Active projects</span><strong>${ps.filter(p=>p.status==='in_progress').length}</strong><small>Ready to resume</small></div><div class="metric"><span>Completed</span><strong>${complete}</strong><small>Milestones reached</small></div></div>${journeyCompanionPanel(state)}<div class="layout" style="margin-top:18px"><div class="stack"><section class="panel"><div class="panel-header"><div><p class="eyebrow">On your workbench</p><h2>${active?'Continue your project':'Choose your next project'}</h2></div></div>${projectGrid(state,4)}</section></div><aside class="stack"><section class="panel next-action"><p class="eyebrow">Recommended next action</p><h2>${active?`Keep going on ${esc(active.title)}`:'Start with one guided project'}</h2><p>${active?`${100-active.completion}% remains. Save one useful step today.`:'The Studio will help you plan, make, reflect, and build a portfolio.'}</p><button class="primary" ${active?`data-edit="${active.id}"`:'data-action="new-project"'}>${active?'Resume project':'Start now'}</button></section></aside></div>${nextStepsPanel(state,eng)}`}

function portfolioCards(state){const ports=filtered(state,state.data.portfolios);return ports.length?`<div class="portfolio-grid">${ports.map(p=>{const detail=p.is_public?'':status(p.review_status);return `<article class="portfolio-card"><span class="status-badge ${p.is_public?'':'private'}">${p.is_public?'🌐 Published':'🔒 Private'}</span><h3>${esc(p.title)}</h3><p>${esc(p.bio||'Add a short creator story when you are ready.')}</p>${detail?`<small>Status: ${esc(detail)}</small>`:''}</article>`}).join('')}</div>`:empty('No portfolio yet','Create a private portfolio for finished work. Publishing still requires the existing parent and admin review process.','create-portfolio','Create portfolio')}
export function projects(state){return `${heading('Project workshop','Projects','Visual progress, useful next actions, and every saved step from the existing project records.','<button class="primary" data-action="new-project">Start a project</button>')}<section class="panel">${projectGrid(state)}</section>${archivedProjects(state)}`}
const isLiveStore=req=>Boolean(req&&(req.status==='approved'||req.status==='published')&&req.public_slug);
export function portfolio(state){const done=filtered(state,state.data.projects).filter(p=>p.status==='completed');const req=filtered(state,state.data.websites)[0];const live=isLiveStore(req);const pathSteps=[['Private by default',true],['Choose a paid tier',state.identity.tier>=3],['Set up your Creation Station Studio',Boolean(req)],['Live and public',live]];return `${heading('Finished work','Portfolio','Every completed project, kept private to your family until you are ready to sell.')}<section class="panel">${done.length?`<div class="card-grid">${done.map(p=>projectCard(state,p)).join('')}</div>`:empty('No finished projects yet','Complete a project and it will show up here, private to your family.','new-project','Start a project')}</section><section class="panel" style="margin-top:18px"><p class="eyebrow">The path to owning your own store</p><h2>${live?'You’re live!':'Where you are on the way to your own storefront'}</h2><p>Your finished work stays private — only you and a parent or guardian can see it — until a paid tier opens up your own Creation Station Studio.</p><div class="readiness">${pathSteps.map(([label,ok])=>`<div class="readiness-row"><strong>${label}</strong><span>${ok?'Done':'Not yet'}</span><div class="progress" role="progressbar" aria-label="${label}" aria-valuenow="${ok?100:0}" aria-valuemin="0" aria-valuemax="100"><span style="width:${ok?100:0}%"></span></div></div>`).join('')}</div>${live?`<a class="button primary" href="creation-station-studio.html?studio=${encodeURIComponent(req.public_slug)}" target="_blank" rel="noopener" style="margin-top:14px">View My Live Page</a>`:state.identity.tier>=3?`<button class="button primary" data-action="website-request" style="margin-top:14px">Set Up My Studio</button>`:`<a class="button primary" href="creation-station-membership.html" style="margin-top:14px">See membership tiers</a>`}</section><section class="panel" style="margin-top:18px"><p class="eyebrow">Creator bio</p><h2>Tell your story</h2><p>A short bio your family can keep private, or submit for the admin team to review before anything is shown publicly. Separate from your finished projects above.</p>${portfolioCards(state)}</section>`}
export function resources(state){return `${heading('Studio library','Resources','Published worksheets, downloads, replays, and references included with this membership.')}<section class="panel">${resourceList(state,state.data.resources)}</section>`}
export function classes(state){return `${heading('Sessions','Learn together, laugh together','Upcoming sessions, registration status, supplies, and available replays.')}<section class="panel">${classList(state,state.data.classes)}</section>`}
export function growth(state){const ps=filtered(state,state.data.projects),done=ps.filter(p=>p.status==='completed').length,rate=ps.length?Math.round(done/ps.length*100):0,avg=ps.length?Math.round(ps.reduce((n,p)=>n+p.completion,0)/ps.length):0,web=filtered(state,state.data.websites),readiness=[['Complete a project',done?100:Math.min(avg,80)],['Build a body of work',done>=3?100:Math.round(Math.min(done,3)/3*100)],['Prepare a creator website',web.length?70:0],['Go live with your store',isLiveStore(web[0])?100:0]];return `${heading('Your Progress','See What You’ve Accomplished','Real progress drawn straight from your project and Studio records.')}<div class="metric-grid"><div class="metric"><span>Projects started</span><strong>${ps.length}</strong><small>Current records</small></div><div class="metric"><span>Projects completed</span><strong>${done}</strong><small>Current records</small></div><div class="metric"><span>Completion rate</span><strong>${rate}%</strong><small>Completed ÷ started</small></div><div class="metric"><span>Average progress</span><strong>${avg}%</strong><small>Across current projects</small></div></div><div class="layout" style="margin-top:18px"><section class="panel"><p class="eyebrow">Readiness</p><h2>Next growth milestone</h2><div class="readiness">${readiness.map(([label,n])=>`<div class="readiness-row"><strong>${label}</strong><span>${n}%</span><div class="progress" role="progressbar" aria-label="${label}" aria-valuenow="${n}" aria-valuemin="0" aria-valuemax="100"><span style="width:${n}%"></span></div></div>`).join('')}</div></section><section class="panel"><p class="eyebrow">Skills developed</p><h2>${new Set(ps.map(p=>state.data.templates.find(t=>t.id===p.template_id)?.category).filter(Boolean)).size} skill areas</h2><div class="tag-row">${[...new Set(ps.map(p=>state.data.templates.find(t=>t.id===p.template_id)?.category).filter(Boolean))].map(x=>`<span class="tag">${esc(x)}</span>`).join('')||'<p>Complete projects to build this record.</p>'}</div><p>Creation Station live sessions attended: <strong>${state.data.registrations.filter(r=>r.attended_at).length}</strong></p></section></div><section class="panel" style="margin-top:18px"><p class="eyebrow">Future Marketplace metrics</p><h2>Not connected yet</h2><p>Marketplace development has not begun. These cards are truthful placeholders and contain no invented activity.</p><div class="future-grid">${['Listings','Views','Inquiries','Orders & revenue'].map(x=>`<div class="future-card"><strong>${x}</strong><span>Marketplace data will appear here</span></div>`).join('')}</div></section>`}
const paymentLabels={paypal:'PayPal',cashapp:'Cash App',zelle:'Zelle',cod:'Cash on delivery',other:'Other'};
const deliveryLabels={shipped:'Shipped',mailed:'Mailed',pickup_customer:'Pickup by customer',dropoff_seller:'Drop off by seller',local_meet:'Local meet'};
const describeMethods=(codes,labels,other)=>codes?.length?codes.map(c=>c==='other'&&other?`Other (${esc(other)})`:esc(labels[c]||c)).join(', '):'Not set yet';
function studioProductsPanel(state,req){if(!req)return'';const products=(state.data.studioProducts||[]).filter(p=>p.website_request_id===req.id);const importedProjectIds=new Set(products.map(p=>p.source_project_id).filter(Boolean));const available=(state.data.projects||[]).filter(p=>p.status==='completed'&&!importedProjectIds.has(p.id));const productCard=p=>`<article class="project-card"><div class="project-art creative" aria-hidden="true">${studioPublicUrl(p.storage_path)?`<img src="${esc(studioPublicUrl(p.storage_path))}" alt="">`:'✦'}</div><div class="project-body"><h3>${esc(p.title)}</h3>${p.price_label?`<p><strong>${esc(formatPrice(p.price_label))}</strong></p>`:''}<p>${esc(p.description||'')}</p><div class="actions"><button class="small" data-edit-product="${p.id}">Edit</button><button class="small" data-delete-product="${p.id}">Remove</button></div></div></article>`;return `<section class="panel" style="margin-top:18px"><div class="panel-header"><div><p class="eyebrow">Studio products</p><h2>What buyers will see</h2></div><div class="actions"><button data-action="toggle-import-picker">Import a finished project</button><button class="primary" data-action="add-product">Add product</button></div></div>${products.length?`<div class="card-grid">${products.map(productCard).join('')}</div>`:'<p>No products yet. Import a finished project or add one directly.</p>'}${state._showImportPicker?`<div class="soft-panel" style="margin-top:14px"><strong>Import a finished project</strong>${available.length?`<div class="list">${available.map(p=>`<article class="list-item"><span class="list-icon" aria-hidden="true">◇</span><div><h3>${esc(p.title||'Untitled')}</h3><p>Completed project</p></div><button data-import-project="${p.id}">Import</button></article>`).join('')}</div>`:'<p>Nothing left to import — finish a project first, or everything finished is already a product.</p>'}</div>`:''}</section>`}
function orderRequestsPanel(state,req){if(!req)return'';const items=(state.data.orderRequests||[]).filter(o=>o.website_request_id===req.id);if(!items.length)return'';return `<section class="panel" style="margin-top:18px"><div class="panel-header"><div><p class="eyebrow">Order requests</p><h2>${items.filter(o=>!o.is_read).length} new</h2></div></div><div class="list">${items.map(o=>`<article class="list-item"><span class="list-icon" aria-hidden="true">${o.is_read?'✓':'●'}</span><div><h3>${esc(o.sender_name)}</h3><p>${esc(o.cart_summary)}</p>${o.message?`<p>${esc(o.message)}</p>`:''}${o.sender_contact?`<p><strong>Contact:</strong> ${esc(o.sender_contact)}</p>`:''}<small>${new Date(o.created_at).toLocaleString()}</small></div></article>`).join('')}</div></section>`}
export function website(state){const req=filtered(state,state.data.websites)[0];const isPaid=state.identity.tier>=3;const hasPaymentDelivery=Boolean(req?.payment_methods?.length&&req?.delivery_methods?.length);const steps=[['Profile',state.identity.creators.length?100:0],['Story',req?.story?100:0],['Products or services',req?.products?100:0],['Payment & delivery',hasPaymentDelivery?100:0],['Approved',req?.status==='approved'||req?.status==='published'?100:req?50:0],['Published',isLiveStore(req)||req?.published_at?100:0]];const liveUrl=req?.public_slug?`creation-station-studio.html?studio=${encodeURIComponent(req.public_slug)}`:null;const introCopy=isPaid?'Fill this out, check the parent approval box, and your Studio goes live immediately — no waiting on review.':'Practice building your Studio here for free — add your story and products, no payment needed. Upgrade any time to publish it for real.';const practiceNotice=(!isPaid&&req)?`<section class="panel" style="margin-top:18px;border-left-color:var(--gold);background:linear-gradient(150deg,#fff1c9,#fbf8ff 55%)"><p class="eyebrow">Practice mode</p><h2>This is a practice run — nothing is public yet</h2><p>You can build your whole Studio for free: story, products, photos. When you're ready for a real public page people can actually visit, upgrade to Creation Station Studio.</p><a class="button primary" href="creation-station-membership.html">Upgrade to publish for real</a></section>`:'';return `${heading('Creation Station Studio',isPaid?'Your Studio page':'Practice your Studio page',introCopy,'<button class="primary" data-action="website-request">Start or update request</button>')}<div class="layout"><section class="panel"><p class="eyebrow">Website readiness</p><h2>${req?esc(req.brand_name):'Build your website brief'}</h2><div class="readiness">${steps.map(([x,n])=>`<div class="readiness-row"><strong>${x}</strong><span>${n}%</span><div class="progress"><span style="width:${n}%"></span></div></div>`).join('')}</div></section><aside class="panel"><p class="eyebrow">Current status</p><h2>${req?esc(status(req.status)):'Not submitted'}</h2><p>${req?.admin_notes?esc(req.admin_notes):isPaid?'Your Studio goes live the moment you submit and pay — no admin wait.':'Practicing for free. Upgrade any time to make it real.'}</p>${req?`<p><strong>Payment:</strong> ${describeMethods(req.payment_methods,paymentLabels,req.payment_other_note)}</p><p><strong>Delivery:</strong> ${describeMethods(req.delivery_methods,deliveryLabels)}</p>`:''}${liveUrl?`<a class="button primary" href="${liveUrl}" target="_blank" rel="noopener">View My Live Page</a>`:''}${req?.published_url?`<a class="button" href="${esc(req.published_url)}">Visit published website</a>`:''}</aside></div>${practiceNotice}${studioProductsPanel(state,req)}${orderRequestsPanel(state,req)}`}
export function parent(state){const creators=state.identity.creators,household=state.identity.household;return `${heading('Parent or Guardian','Encourage progress, protect privacy','A useful view of growth and approvals without turning creativity into surveillance.')}<div class="metric-grid"><div class="metric"><span>Household creators</span><strong>${creators.length}</strong><small>Active profiles</small></div><div class="metric"><span>Projects completed</span><strong>${state.data.projects.filter(p=>p.status==='completed').length}</strong><small>Across the household</small></div><div class="metric"><span>Portfolio submissions</span><strong>${state.data.portfolios.filter(p=>p.review_status==='submitted').length}</strong><small>Awaiting review</small></div><div class="metric"><span>Live sessions attended</span><strong>${state.data.registrations.filter(r=>r.attended_at).length}</strong><small>Creation Station gatherings only</small></div></div><div class="layout" style="margin-top:18px"><section class="panel"><p class="eyebrow">Household creators</p><h2>What they are building</h2><div class="list">${creators.map(c=>{const ps=state.data.projects.filter(p=>p.creator_id===c.id),done=ps.filter(p=>p.status==='completed').length,active=ps.filter(p=>p.status!=='archived'),notesList=active.length?`<div class="parent-project-notes">${active.map(p=>`<div class="parent-project-note"><strong>${esc(p.title)}</strong><span>${esc(parseReflection(p.notes).description||'No description yet')}</span></div>`).join('')}</div>`:'';return `<article class="list-item"><span class="list-icon" aria-hidden="true">${c.age_band==='young_6_12'?'✦':'◇'}</span><div><h3>${esc(c.display_name)}</h3><p>${ps.length} projects · ${done} completed · ${esc(status(c.age_band))}</p>${notesList}</div><div class="actions"><button class="small" data-view-portfolio="${c.id}">View Portfolio</button><button class="small" data-select-creator="${c.id}">Open Studio</button></div></article>`}).join('')||'<p>No creator profiles yet.</p>'}</div></section><aside class="stack"><section class="panel"><p class="eyebrow">Privacy & approvals</p><h2>Public visibility</h2><p>${state.data.portfolios.filter(p=>p.is_public).length} published portfolios. Everything else stays just between your family — nothing goes public without your say-so.</p><button data-route-go="portfolio">Review portfolio status</button></section><section class="panel"><p class="eyebrow">Membership</p><h2>${esc(state.tierName)}</h2><p>No setup fee. No hosting fee. No minimum commitment.</p><div class="tag-row" style="margin-bottom:12px"><span class="status-badge private">Private portfolio</span><span class="status-badge private">Progress tracking</span><span class="status-badge private">Parent control</span></div><a class="button" href="creation-station-membership.html#inside">See all benefits</a></section></aside></div>${(state.data.websites||[]).length?`<section class="panel" style="margin-top:18px"><p class="eyebrow">Creation Station Studio</p><h2>Live storefronts</h2><div class="list">${state.data.websites.map(w=>{const c=creators.find(x=>x.id===w.creator_id);const liveUrl=w.public_slug?`creation-station-studio.html?studio=${encodeURIComponent(w.public_slug)}`:null;return `<article class="list-item"><span class="list-icon" aria-hidden="true">✦</span><div><h3>${esc(w.brand_name)}</h3><p>${esc(c?.display_name||'Creator')} · ${esc(status(w.status))}</p></div>${liveUrl?`<a class="button primary" href="${liveUrl}" target="_blank" rel="noopener">View live page</a>`:'<span class="status-badge review">Not live yet</span>'}</article>`}).join('')}</div></section>`:''}<section class="panel" style="margin-top:18px"><p class="eyebrow">Kid Mode</p><h2>Give each creator their own way in</h2><p>Set a PIN so a creator can jump straight into their own space — Studio, Projects, Portfolio, Resources, Sessions, and Growth only, no Parent View, Admin, or creator switcher. This is a simple way to keep young hands out of settings, not an account security feature.</p><div class="list">${creators.map(c=>`<article class="list-item"><span class="list-icon" aria-hidden="true">${c.age_band==='young_6_12'?'✦':'◇'}</span><div><h3>${esc(c.display_name)}</h3><p>${c.kid_pin?'PIN is set':'No PIN set yet'}</p></div><button class="small" data-set-kid-pin="${c.id}">${c.kid_pin?'Change PIN':'Set PIN'}</button></article>`).join('')||'<p>No creator profiles yet.</p>'}</div><div class="soft-panel" style="margin-top:14px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap"><div><strong>Your parent PIN</strong><p style="margin:4px 0 0;color:var(--muted)">${household?.parent_pin?'A parent PIN is set — needed to exit Kid Mode.':'Set one so Kid Mode can be exited once it\'s on.'}</p></div><button data-action="set-parent-pin">${household?.parent_pin?'Change parent PIN':'Set parent PIN'}</button></div></section>`}
const sessionRow=c=>`<article class="list-item"><span class="list-icon" aria-hidden="true">▣</span><div><h3>${esc(c.title)}</h3><p>${new Date(c.starts_at).toLocaleString()}${c.capacity?` · capacity ${c.capacity}`:''}</p></div><div class="actions"><span class="status-badge ${c.is_published?'':'review'}">${c.is_published?'Published':'Draft'}</span><button class="small" data-edit-session="${c.id}">Edit</button></div></article>`;
export function admin(state){const a=state.adminData||{portfolioQueue:[],websiteQueue:[],allProjects:[],allCreators:[],allClasses:[],orderRequests:[]};return `${heading('Admin view','Studio operations','Review truthful queues and platform activity while preserving the existing security model.')}<div class="metric-grid"><div class="metric"><span>Active creators</span><strong>${a.allCreators.filter(x=>x.profile_status==='active').length}</strong><small>Platform records</small></div><div class="metric"><span>Projects</span><strong>${a.allProjects.length}</strong><small>All current records</small></div><div class="metric"><span>Portfolio queue</span><strong>${a.portfolioQueue.length}</strong><small>Submitted or changes requested</small></div><div class="metric"><span>Website queue</span><strong>${a.websiteQueue.length}</strong><small>Submitted or changes requested</small></div></div><div class="layout" style="margin-top:18px"><section class="panel"><p class="eyebrow">Moderation</p><h2>Review queue</h2><div class="list">${[...a.portfolioQueue.map(x=>({type:'portfolio',id:x.id,label:x.title||'Portfolio',status:x.review_status})),...a.websiteQueue.map(x=>({type:'website',id:x.id,label:x.brand_name||'Website request',status:x.status}))].map(x=>`<article class="list-item"><span class="list-icon">✓</span><div><h3>${esc(x.label)}</h3><p>${esc(status(x.status))}</p></div><button class="small" data-review="${x.type}:${x.id}">Review</button></article>`).join('')||'<p>Nothing is waiting for review.</p>'}</div></section><aside class="panel"><p class="eyebrow">Security boundary</p><h2>Admin controls stay server-enforced</h2><p>This view only presents records allowed by the existing admin RLS policies. Private storage remains private.</p></aside></div><section class="panel" style="margin-top:18px"><div class="panel-header"><div><p class="eyebrow">Sessions</p><h2>Schedule &amp; manage live sessions</h2></div><button class="primary" data-action="new-session">Schedule session</button></div><div class="list">${a.allClasses.map(sessionRow).join('')||'<p>No sessions scheduled yet.</p>'}</div></section><section class="panel" style="margin-top:18px"><div class="panel-header"><div><p class="eyebrow">Studio</p><h2>Order requests</h2></div></div><div class="list">${(a.orderRequests||[]).map(o=>`<article class="list-item"><span class="list-icon" aria-hidden="true">${o.is_read?'✓':'●'}</span><div><h3>${esc(o.sender_name)}</h3><p>${esc(o.cart_summary)}</p>${o.message?`<p>${esc(o.message)}</p>`:''}${o.sender_contact?`<p><strong>Contact:</strong> ${esc(o.sender_contact)}</p>`:''}<small>${new Date(o.created_at).toLocaleString()}</small></div>${o.is_read?'':`<button class="small" data-mark-order-read="${o.id}">Mark read</button>`}</article>`).join('')||'<p>No order requests yet.</p>'}</div></section>`}

export const renderers={studio,projects,portfolio,resources,classes,growth,website,parent,admin};
