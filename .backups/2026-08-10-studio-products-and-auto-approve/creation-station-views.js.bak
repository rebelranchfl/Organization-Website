const esc=(v='')=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML};
const status=(v='draft')=>v.replaceAll('_',' ');
const iconFor=c=>({business:'↗',website:'◇',creative:'✦'}[c]||'✦');
const fmtMinutes=n=>n?`${n<60?n:`${Math.round(n/60*10)/10} hr`} estimated`:'Effort varies';
const filtered=(state,list,key='creator_id')=>state.creatorId==='all'?list:list.filter(x=>x[key]===state.creatorId);
const creatorName=(state,id)=>state.identity.creators.find(c=>c.id===id)?.display_name||'Creator';
const heading=(eyebrow,title,copy,action='')=>`<header class="screen-heading"><div><p class="eyebrow">${eyebrow}</p><h2>${title}</h2><p>${copy}</p></div>${action}</header>`;
const empty=(title,copy,action,label)=>`<section class="empty-state"><span class="empty-icon" aria-hidden="true">✦</span><h2>${title}</h2><p>${copy}</p>${label?`<button class="button primary" data-action="${action}">${label}</button>`:''}</section>`;
const projectCard=(state,p)=>{const t=state.data.templates.find(x=>x.id===p.template_id)||{};return `<article class="project-card"><div class="project-art ${esc(t.category)}" aria-hidden="true">${iconFor(t.category)}</div><div class="project-body"><div class="meta-row"><span class="status-badge status-${esc(p.status)}">${esc(status(p.status))}</span><span>${esc(creatorName(state,p.creator_id))}</span></div><h3>${esc(p.title)} ${p.is_favorite?'<span aria-label="Favorite">★</span>':''}</h3><div class="progress" role="progressbar" aria-label="Project completion" aria-valuenow="${p.completion}" aria-valuemin="0" aria-valuemax="100"><span style="width:${p.completion}%"></span></div><div class="meta-row"><strong>${p.completion}% complete</strong><span>${esc(fmtMinutes(t.estimated_minutes))}</span></div>${p.notes?`<p>${esc(p.notes)}</p>`:''}<div class="tag-row"><span class="tag">${esc(t.category||'creative')}</span><span class="tag">${esc(t.difficulty||'self paced')}</span></div><div class="actions"><button class="primary" data-edit="${p.id}">${p.status==='completed'?'View project':'Resume Project'}</button><button data-favorite="${p.id}">${p.is_favorite?'Remove favorite':'Favorite'}</button></div></div></article>`};
const projectGrid=(state,limit)=>{const ps=filtered(state,state.data.projects).filter(p=>p.status!=='archived').slice(0,limit||999);return ps.length?`<div class="card-grid">${ps.map(p=>projectCard(state,p)).join('')}</div>`:empty('Your first idea starts here','Choose a guided project and the Studio will save your progress privately.','new-project','Start a project')};
const archivedProjects=state=>{const ps=filtered(state,state.data.projects).filter(p=>p.status==='archived');return ps.length?`<section class="panel" style="margin-top:18px"><div class="panel-header"><div><p class="eyebrow">Archive</p><h2>Archived projects</h2></div></div><div class="list">${ps.map(p=>`<article class="list-item"><span class="list-icon" aria-hidden="true">◇</span><div><h3>${esc(p.title)}</h3><p>${p.completion}% complete · ${esc(creatorName(state,p.creator_id))}</p></div><button data-restore="${p.id}">Restore project</button></article>`).join('')}</div></section>`:''};
const resourceList=(state,items)=>items.length?`<div class="list">${items.map(r=>`<article class="list-item"><span class="list-icon" aria-hidden="true">${r.resource_type==='worksheet'?'▤':'↗'}</span><div><h3>${esc(r.title)}</h3><p>${esc(r.description)}</p><small>${esc(status(r.resource_type))}</small></div>${r.external_url?`<a class="button" href="${esc(r.external_url)}" target="_blank" rel="noopener">Open<span class="sr-only"> ${esc(r.title)}</span></a>`:'<span class="status-badge private">Member file</span>'}</article>`).join('')}</div>`:empty('Resources are being prepared','Published worksheets, downloads, and references for your tier will appear here.','','');
const classList=(state,items)=>items.length?`<div class="list">${items.map(c=>{const reg=state.data.registrations.find(r=>r.class_id===c.id&&(state.creatorId==='all'||r.creator_id===state.creatorId));const upcoming=new Date(c.starts_at)>new Date();const supplies=Array.isArray(c.supply_list)&&c.supply_list.length?esc(c.supply_list.join(', ')):'No supply list yet';return `<article class="list-item"><span class="list-icon" aria-hidden="true">▣</span><div><h3>${esc(c.title)}</h3><p>${new Date(c.starts_at).toLocaleString()}</p>${c.description?`<p>${esc(c.description)}</p>`:''}<small>Supplies: ${supplies} · ${upcoming?'Upcoming':'Replay or attendance record'}</small></div><span class="status-badge ${reg?'':'review'}">${reg?'Registered':'Not registered'}</span></article>`}).join('')}</div>`:empty('No published sessions yet','Upcoming sessions, supply lists, registration status, and replays will appear here.','','');

export const journeyStages=[['Dream It','Imagine big','dream'],['Plan It','Make a plan','plan'],['Make It','Build it up','make'],['Capture It','Show your work','capture'],['Share It','Inspire others','share'],['Grow It','Keep learning','grow']];
export const stageIndexFor=p=>{if(!p||p.status==='not_started')return 0;if(p.status==='completed')return 5;const c=p.completion||0;if(c<=10)return 1;if(c<=40)return 2;if(c<=70)return 3;return 4};
const stageProgressTable=[{status:'not_started',completion:0},{status:'in_progress',completion:5},{status:'in_progress',completion:25},{status:'in_progress',completion:55},{status:'in_progress',completion:85},{status:'completed',completion:100}];
export const stageToProgress=idx=>stageProgressTable[idx]||stageProgressTable[0];
function journeyTracker(state){const ps=filtered(state,state.data.projects).filter(p=>p.status!=='archived'),active=ps.find(p=>p.status==='in_progress')||ps[0]||null,idx=stageIndexFor(active);return `<section class="panel journey-panel"><p class="eyebrow">Your Creation Journey</p><h2>${active?esc(active.title):'Start your first project to begin the journey'}</h2><div class="journey-track">${journeyStages.map(([label,sub,key],i)=>`<div class="journey-stage stage-${key} ${i===idx?'is-current':''} ${i<idx?'is-done':''}"><span class="journey-dot" aria-hidden="true">${i<idx?'✓':i+1}</span><strong>${label}</strong><small>${sub}</small></div>`).join('<span class="journey-line" aria-hidden="true"></span>')}</div></section>`}

const activityDays=dates=>[...new Set(dates.map(d=>d.slice(0,10)))].sort().reverse();
const dayGap=(a,b)=>Math.round((Date.parse(a)-Date.parse(b))/86400000);
function computeStreak(dates){const days=activityDays(dates);if(!days.length)return 0;const today=new Date().toISOString().slice(0,10);if(dayGap(today,days[0])>5)return 0;let n=1;for(let i=1;i<days.length;i++){if(dayGap(days[i-1],days[i])>5)break;n++}return n}
export function engagement(state){const rows=filtered(state,state.data.activity),points=rows.length,streak=computeStreak(rows.map(r=>r.created_at)),projectsForBadge=filtered(state,state.data.projects),badgeEarned=projectsForBadge.some(p=>p.status==='completed');return {points,streak,badgeEarned}}
function achievementPanel(state,eng){if(!eng.badgeEarned)return'';const readyForStudio=state.identity.tier>=3;const studioAction=readyForStudio?'<button class="button primary" data-action="website-request">Set Up My Studio</button>':'<a class="button primary" href="creation-station-membership.html">Set Up My Studio</a>';return `<section class="panel achievement-panel"><span class="badge-medal" aria-hidden="true">★</span><div class="achievement-body"><p class="eyebrow">First Project Badge</p><h2>You finished your first project!</h2><p>That work is ready for your portfolio. Here is what you can do next.</p><div class="achievement-choices"><div class="achievement-choice"><strong>Ready to sell what you made?</strong><span>Go straight to your own Creation Station Studio website.</span>${studioAction}</div><div class="achievement-choice"><strong>Not quite ready yet? That's okay!</strong><span>Keep creating and practicing here.</span><button class="button" data-action="new-project">Keep Practicing</button></div><div class="achievement-choice"><strong>Want to run it like a pro?</strong><span>Need help with pricing, marketing, listing your product, or setting up your shop the right way? Our business sessions get you ready to launch.</span><a class="button" href="academy-learning-interest.html" target="_blank" rel="noopener">Business Sessions at Academy</a></div></div></div></section>`}

export function audience(state){const c=state.identity.creators.find(x=>x.id===state.creatorId)||state.identity.creators[0];if(state.view==='parent')return'parent';if(state.view==='admin')return'admin';if(!c)return'adult';if(c.age_band==='young_6_12')return'young';if(c.age_band==='teen_13_17')return'teen';return'adult'}
export function copyForAudience(a,name){return {young:{line1:'Ready to make something,',line2:`${name}?`,copy:'Choose your next creative step, keep going, and celebrate what you learn.'},teen:{line1:'Build what is yours,',line2:`${name}.`,copy:'Own the process, sharpen your skills, and turn strong work into a portfolio.'},adult:{line1:'Welcome back to the Studio,',line2:`${name}.`,copy:'Move your creative work forward while building the portfolio and readiness behind it.'},parent:{line1:'See the growth',line2:'behind the making.',copy:'Support each creator with useful context, clear approvals, and encouraging next steps.'},admin:{line1:'Creation Station',line2:'operations.',copy:'Monitor readiness and review queues without changing the member experience.'}}[a]}

export function studio(state){const ps=filtered(state,state.data.projects),active=ps.find(p=>p.status==='in_progress'),complete=ps.filter(p=>p.status==='completed').length,eng=engagement(state);return `${heading('Creator Studio','Make, learn, and keep moving','Your creative home for projects, portfolios, sessions, and the next useful step.','<button class="primary" data-action="new-project">Start something new</button>')}${journeyTracker(state)}${achievementPanel(state,eng)}<div class="metric-grid"><div class="metric"><span>Active projects</span><strong>${ps.filter(p=>p.status==='in_progress').length}</strong><small>Ready to resume</small></div><div class="metric"><span>Completed</span><strong>${complete}</strong><small>Milestones reached</small></div><div class="metric"><span>Portfolio status</span><strong>${filtered(state,state.data.portfolios).length?'Started':'Next'}</strong><small>Private until approved</small></div><div class="metric"><span>Skills practiced</span><strong>${new Set(ps.filter(p=>p.status==='completed'||p.completion>10).map(p=>state.data.templates.find(t=>t.id===p.template_id)?.category).filter(Boolean)).size}</strong><small>From real progress, not just started projects</small></div></div><div class="layout" style="margin-top:18px"><div class="stack"><section class="panel"><div class="panel-header"><div><p class="eyebrow">On your workbench</p><h2>${active?'Continue your project':'Choose your next project'}</h2></div><button data-action="new-project">Browse projects</button></div>${projectGrid(state,4)}</section><section class="panel"><div class="panel-header"><div><p class="eyebrow">Portfolio preview</p><h2>Work worth remembering</h2></div><button data-route-go="portfolio">View portfolio</button></div>${portfolioCards(state)}</section></div><aside class="stack"><section class="panel next-action"><p class="eyebrow">Recommended next action</p><h2>${active?`Keep going on ${esc(active.title)}`:'Start with one guided project'}</h2><p>${active?`${100-active.completion}% remains. Save one useful step today.`:'The Studio will help you plan, make, reflect, and build a portfolio.'}</p><button class="primary" ${active?`data-edit="${active.id}"`:'data-action="new-project"'}>${active?'Resume project':'Start now'}</button></section><section class="panel"><div class="panel-header"><h2>Upcoming</h2><button data-route-go="classes">All sessions</button></div>${classList(state,state.data.classes.filter(c=>new Date(c.starts_at)>new Date()).slice(0,2))}</section><section class="panel"><div class="panel-header"><h2>Studio tools</h2><button data-route-go="resources">All resources</button></div>${resourceList(state,state.data.resources.slice(0,2))}</section></aside></div>${state.identity.tier>=3?`<section class="panel" style="margin-top:18px"><p class="eyebrow">Next step</p><h2>Ready to run it like a pro?</h2><p>Need help with pricing, marketing, listing your product, or setting up your shop the right way? Our business sessions get you ready to launch.</p><a class="button primary" href="academy-learning-interest.html" target="_blank" rel="noopener">Business Sessions at Academy</a></section>`:''}`}

function portfolioCards(state){const ports=filtered(state,state.data.portfolios);return ports.length?`<div class="portfolio-grid">${ports.map(p=>`<article class="portfolio-card"><span class="status-badge ${p.is_public?'':'private'}">${p.is_public?'published':status(p.review_status)}</span><h3>${esc(p.title)}</h3><p>${esc(p.bio||'Add a short creator story when you are ready.')}</p><small>${p.is_public?'Public only after approval':'Private by default'}</small></article>`).join('')}</div>`:empty('No portfolio yet','Create a private portfolio for finished work. Publishing still requires the existing parent and admin review process.','create-portfolio','Create portfolio')}
export function projects(state){return `${heading('Project workshop','Projects','Visual progress, useful next actions, and every saved step from the existing project records.','<button class="primary" data-action="new-project">Start a project</button>')}<section class="panel">${projectGrid(state)}</section>${archivedProjects(state)}`}
export function portfolio(state){return `${heading('Private by default','Portfolio','Shape a body of work while keeping approval and publishing status clear.')}<section class="panel">${portfolioCards(state)}</section><section class="panel" style="margin-top:18px"><p class="eyebrow">Publishing path</p><h2>Private → Submitted → Reviewed → Published</h2><p>Young and teen creator work remains under parent or guardian control. Nothing private is made public by this Studio.</p></section>`}
export function resources(state){return `${heading('Studio library','Resources','Published worksheets, downloads, replays, and references included with this membership.')}<section class="panel">${resourceList(state,state.data.resources)}</section>`}
export function classes(state){return `${heading('Learn together','Sessions','Upcoming sessions, registration status, supplies, and available replays.')}<section class="panel">${classList(state,state.data.classes)}</section>`}
export function growth(state){const ps=filtered(state,state.data.projects),done=ps.filter(p=>p.status==='completed').length,rate=ps.length?Math.round(done/ps.length*100):0,avg=ps.length?Math.round(ps.reduce((n,p)=>n+p.completion,0)/ps.length):0,ports=filtered(state,state.data.portfolios),web=filtered(state,state.data.websites),readiness=[['Complete a project',done?100:Math.min(avg,80)],['Build a portfolio',ports.length?65:0],['Submit approved public work',ports.some(p=>p.review_status==='approved')?100:0],['Prepare a creator website',web.length?70:0]];return `${heading('Business Growth','Growth dashboard','Serious progress and readiness metrics drawn from the same Studio records.')}<div class="metric-grid"><div class="metric"><span>Projects started</span><strong>${ps.length}</strong><small>Current records</small></div><div class="metric"><span>Projects completed</span><strong>${done}</strong><small>Current records</small></div><div class="metric"><span>Completion rate</span><strong>${rate}%</strong><small>Completed ÷ started</small></div><div class="metric"><span>Average progress</span><strong>${avg}%</strong><small>Across current projects</small></div></div><div class="layout" style="margin-top:18px"><section class="panel"><p class="eyebrow">Readiness</p><h2>Next growth milestone</h2><div class="readiness">${readiness.map(([label,n])=>`<div class="readiness-row"><strong>${label}</strong><span>${n}%</span><div class="progress" role="progressbar" aria-label="${label}" aria-valuenow="${n}" aria-valuemin="0" aria-valuemax="100"><span style="width:${n}%"></span></div></div>`).join('')}</div></section><section class="panel"><p class="eyebrow">Skills developed</p><h2>${new Set(ps.map(p=>state.data.templates.find(t=>t.id===p.template_id)?.category).filter(Boolean)).size} skill areas</h2><div class="tag-row">${[...new Set(ps.map(p=>state.data.templates.find(t=>t.id===p.template_id)?.category).filter(Boolean))].map(x=>`<span class="tag">${esc(x)}</span>`).join('')||'<p>Complete projects to build this record.</p>'}</div><p>Creation Station live sessions attended: <strong>${state.data.registrations.filter(r=>r.attended_at).length}</strong></p></section></div><section class="panel" style="margin-top:18px"><p class="eyebrow">Future Marketplace metrics</p><h2>Not connected yet</h2><p>Marketplace development has not begun. These cards are truthful placeholders and contain no invented activity.</p><div class="future-grid">${['Listings','Views','Inquiries','Orders & revenue'].map(x=>`<div class="future-card"><strong>${x}</strong><span>Marketplace data will appear here</span></div>`).join('')}</div></section>`}
const paymentLabels={paypal:'PayPal',cashapp:'Cash App',zelle:'Zelle',cod:'Cash on delivery',other:'Other'};
const deliveryLabels={shipped:'Shipped',mailed:'Mailed',pickup_customer:'Pickup by customer',dropoff_seller:'Drop off by seller',local_meet:'Local meet'};
const describeMethods=(codes,labels,other)=>codes?.length?codes.map(c=>c==='other'&&other?`Other (${esc(other)})`:esc(labels[c]||c)).join(', '):'Not set yet';
export function website(state){const req=filtered(state,state.data.websites)[0];const hasPaymentDelivery=Boolean(req?.payment_methods?.length&&req?.delivery_methods?.length);const steps=[['Profile',state.identity.creators.length?100:0],['Story',req?.story?100:0],['Products or services',req?.products?100:0],['Payment & delivery',hasPaymentDelivery?100:0],['Review',req?.status==='approved'||req?.status==='published'?100:req?50:0],['Published',req?.published_at?100:0]];return `${heading('Creation Station Studio','Managed website workflow','Prepare your story and materials for review. Members never upload arbitrary site code.','<button class="primary" data-action="website-request">Start or update request</button>')}<div class="layout"><section class="panel"><p class="eyebrow">Website readiness</p><h2>${req?esc(req.brand_name):'Build your website brief'}</h2><div class="readiness">${steps.map(([x,n])=>`<div class="readiness-row"><strong>${x}</strong><span>${n}%</span><div class="progress"><span style="width:${n}%"></span></div></div>`).join('')}</div></section><aside class="panel"><p class="eyebrow">Current status</p><h2>${req?esc(status(req.status)):'Not submitted'}</h2><p>${req?.admin_notes?esc(req.admin_notes):'Review notes will appear here when a request is evaluated.'}</p>${req?`<p><strong>Payment:</strong> ${describeMethods(req.payment_methods,paymentLabels,req.payment_other_note)}</p><p><strong>Delivery:</strong> ${describeMethods(req.delivery_methods,deliveryLabels)}</p>`:''}${req?.published_url?`<a class="button primary" href="${esc(req.published_url)}">Visit published website</a>`:''}</aside></div>`}
export function parent(state){const creators=state.identity.creators,household=state.identity.household;return `${heading('Parent or Guardian','Encourage progress, protect privacy','A useful view of growth and approvals without turning creativity into surveillance.')}<div class="metric-grid"><div class="metric"><span>Household creators</span><strong>${creators.length}</strong><small>Active profiles</small></div><div class="metric"><span>Projects completed</span><strong>${state.data.projects.filter(p=>p.status==='completed').length}</strong><small>Across the household</small></div><div class="metric"><span>Portfolio submissions</span><strong>${state.data.portfolios.filter(p=>p.review_status==='submitted').length}</strong><small>Awaiting review</small></div><div class="metric"><span>Live sessions attended</span><strong>${state.data.registrations.filter(r=>r.attended_at).length}</strong><small>Creation Station gatherings only</small></div></div><div class="layout" style="margin-top:18px"><section class="panel"><p class="eyebrow">Household creators</p><h2>What they are building</h2><div class="list">${creators.map(c=>{const ps=state.data.projects.filter(p=>p.creator_id===c.id),done=ps.filter(p=>p.status==='completed').length;return `<article class="list-item"><span class="list-icon" aria-hidden="true">${c.age_band==='young_6_12'?'✦':'◇'}</span><div><h3>${esc(c.display_name)}</h3><p>${ps.length} projects · ${done} completed · ${esc(status(c.age_band))}</p></div><button data-select-creator="${c.id}">Open Studio</button></article>`}).join('')||'<p>No creator profiles yet.</p>'}</div></section><aside class="stack"><section class="panel"><p class="eyebrow">Privacy & approvals</p><h2>Public visibility</h2><p>${state.data.portfolios.filter(p=>p.is_public).length} published portfolios. Everything else stays just between your family — nothing goes public without your say-so.</p><button data-route-go="portfolio">Review portfolio status</button></section><section class="panel"><p class="eyebrow">Membership</p><h2>${esc(state.tierName)}</h2><p>No setup fee. No hosting fee. No minimum commitment.</p><div class="tag-row" style="margin-bottom:12px"><span class="tag">Private portfolio</span><span class="tag">Progress tracking</span><span class="tag">Parent control</span></div><a class="button" href="creation-station-membership.html#inside">See all benefits</a></section></aside></div><section class="panel" style="margin-top:18px"><p class="eyebrow">Kid Mode</p><h2>Give each creator their own way in</h2><p>Set a PIN so a creator can jump straight into their own space — Studio, Projects, Portfolio, Resources, Sessions, and Growth only, no Parent View, Admin, or creator switcher. This is a simple way to keep young hands out of settings, not an account security feature.</p><div class="list">${creators.map(c=>`<article class="list-item"><span class="list-icon" aria-hidden="true">${c.age_band==='young_6_12'?'✦':'◇'}</span><div><h3>${esc(c.display_name)}</h3><p>${c.kid_pin?'PIN is set':'No PIN set yet'}</p></div><button data-set-kid-pin="${c.id}">${c.kid_pin?'Change PIN':'Set PIN'}</button></article>`).join('')||'<p>No creator profiles yet.</p>'}</div><div class="soft-panel" style="margin-top:14px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap"><div><strong>Your parent PIN</strong><p style="margin:4px 0 0;color:var(--muted)">${household?.parent_pin?'A parent PIN is set — needed to exit Kid Mode.':'Set one so Kid Mode can be exited once it\'s on.'}</p></div><button data-action="set-parent-pin">${household?.parent_pin?'Change parent PIN':'Set parent PIN'}</button></div></section>`}
const sessionRow=c=>`<article class="list-item"><span class="list-icon" aria-hidden="true">▣</span><div><h3>${esc(c.title)}</h3><p>${new Date(c.starts_at).toLocaleString()}${c.capacity?` · capacity ${c.capacity}`:''}</p></div><div class="actions"><span class="status-badge ${c.is_published?'':'review'}">${c.is_published?'Published':'Draft'}</span><button data-edit-session="${c.id}">Edit</button></div></article>`;
export function admin(state){const a=state.adminData||{portfolioQueue:[],websiteQueue:[],allProjects:[],allCreators:[],allClasses:[]};return `${heading('Admin view','Studio operations','Review truthful queues and platform activity while preserving the existing security model.')}<div class="metric-grid"><div class="metric"><span>Active creators</span><strong>${a.allCreators.filter(x=>x.profile_status==='active').length}</strong><small>Platform records</small></div><div class="metric"><span>Projects</span><strong>${a.allProjects.length}</strong><small>All current records</small></div><div class="metric"><span>Portfolio queue</span><strong>${a.portfolioQueue.length}</strong><small>Submitted or changes requested</small></div><div class="metric"><span>Website queue</span><strong>${a.websiteQueue.length}</strong><small>Submitted or changes requested</small></div></div><div class="layout" style="margin-top:18px"><section class="panel"><p class="eyebrow">Moderation</p><h2>Review queue</h2><div class="list">${[...a.portfolioQueue.map(x=>({type:'portfolio',id:x.id,label:x.title||'Portfolio',status:x.review_status})),...a.websiteQueue.map(x=>({type:'website',id:x.id,label:x.brand_name||'Website request',status:x.status}))].map(x=>`<article class="list-item"><span class="list-icon">✓</span><div><h3>${esc(x.label)}</h3><p>${esc(status(x.status))}</p></div><button data-review="${x.type}:${x.id}">Review</button></article>`).join('')||'<p>Nothing is waiting for review.</p>'}</div></section><aside class="panel"><p class="eyebrow">Security boundary</p><h2>Admin controls stay server-enforced</h2><p>This view only presents records allowed by the existing admin RLS policies. Private storage remains private.</p></aside></div><section class="panel" style="margin-top:18px"><div class="panel-header"><div><p class="eyebrow">Sessions</p><h2>Schedule &amp; manage live sessions</h2></div><button class="primary" data-action="new-session">Schedule session</button></div><div class="list">${a.allClasses.map(sessionRow).join('')||'<p>No sessions scheduled yet.</p>'}</div></section>`}

export const renderers={studio,projects,portfolio,resources,classes,growth,website,parent,admin};
