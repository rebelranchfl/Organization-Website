  <div class="modal-backdrop" id="requestModal" aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-header">
        <button class="close-modal" type="button" id="closeModal" aria-label="Close form">×</button>
        <h2 id="modalTitle">July Freedom Special Request</h2>
        <p>Tell us what you are building and what kind of help would move it forward.</p>
      </div>

      <form action="https://formspree.io/f/xnjrqydq" method="POST">
        <input type="hidden" name="_subject" value="July Freedom Special Request" />
        <input type="hidden" name="interest_clicked" id="interestClicked" value="General July Program Request" />

        <div class="form-row">
          <div>
            <label for="name">Name *</label>
            <input id="name" name="name" type="text" required />
          </div>
          <div>
            <label for="email">Email *</label>
            <input id="email" name="email" type="email" required />
          </div>
        </div>

        <div class="form-row">
          <div>
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" />
          </div>
          <div>
            <label for="county">County / Area</label>
            <input id="county" name="county_area" type="text" placeholder="Gilchrist, Levy, Alachua, Dixie, Marion..." />
          </div>
        </div>

        <label for="program">Which $250 July program are you interested in? *</label>
        <select id="program" name="program_interest" required>
          <option value="">Select one</option>
          <option value="Bring Home The Bacon - $250">Bring Home The Bacon (Business Operations) — $250</option>
          <option value="Spread The Word - $250">Spread The Word (Online &amp; Marketing) — $250</option>
          <option value="Preach it Teach - $250">Preach it Teach (Class Setup) — $250</option>
          <option value="Payment Plan Request">Payment Plan Request</option>
          <option value="Not Sure Yet">Not sure yet</option>
        </select>

        <label for="project">Business / Program / Project Name</label>
        <input id="project" name="business_program_project_name" type="text" />

        <label for="message">What are you trying to build, clean up, or launch? *</label>
        <textarea id="message" name="message" required placeholder="Example: I need help with business analysis, operational excellence, merchant services, online presence, social media marketing, SEO, CRM, booking, online classes, or a custom action plan."></textarea>

        <div class="checkbox-line">
          <input id="paymentPlanToggle" name="needs_payment_plan" type="checkbox" value="Yes" />
          <label for="paymentPlanToggle" style="margin: 0;">I need a payment plan for the $250 program fee.</label>
        </div>

        <div class="payment-plan-panel" id="paymentPlanPanel">
          <label for="paymentPlanNotes">Payment plan request details</label>
          <textarea id="paymentPlanNotes" name="payment_plan_notes" placeholder="Tell us what would make the $250 program accessible. Example: deposit amount, weekly option, or timing."></textarea>
        </div>

        <label for="availability">Best days/times for Zoom or video call</label>
        <input id="availability" name="availability" type="text" placeholder="Example: weekday evenings, Saturday morning, Friday afternoon" />

        <div class="form-note">
          Program payments are paid directly to Faith Family & Nature Church for FFN-operated
          educational, community, and program-development work. Program payments support FFN programs,
          Rebel Ranch Ministries, community education, and operational development.
        </div>

        <div class="buttons">
          <button class="btn btn-gold" type="submit">Submit Request</button>
          <button class="btn btn-black" type="button" id="cancelModal">Cancel</button>
        </div>
      </form>
    </div>
  </div>


  <script>
    // Countdown to end of July Freedom Special (July 31, 2026, 11:59:59 PM local time)
    (function () {
      const deadline = new Date("2026-07-31T23:59:59");
      const heroText = document.getElementById("heroCountdownText");
      const dEl = document.getElementById("cd-days");
      const hEl = document.getElementById("cd-hours");
      const mEl = document.getElementById("cd-mins");
      const sEl = document.getElementById("cd-secs");

      function pad(n) { return String(n).padStart(2, "0"); }

      function tick() {
        const now = new Date();
        let diff = deadline - now;

        if (diff <= 0) {
          if (heroText) heroText.textContent = "The July Freedom Special has ended — reach out about future offers.";
          if (dEl) { dEl.textContent = "00"; hEl.textContent = "00"; mEl.textContent = "00"; sEl.textContent = "00"; }
          clearInterval(intervalId);
          return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const mins = Math.floor((diff / (1000 * 60)) % 60);
        const secs = Math.floor((diff / 1000) % 60);

        if (heroText) {
          heroText.innerHTML = `<b>${days}d ${pad(hours)}h ${pad(mins)}m ${pad(secs)}s</b> left in the July Freedom Special`;
        }
        if (dEl) dEl.textContent = pad(days);
        if (hEl) hEl.textContent = pad(hours);
        if (mEl) mEl.textContent = pad(mins);
        if (sEl) sEl.textContent = pad(secs);
      }

      tick();
      const intervalId = setInterval(tick, 1000);
    })();

    const modal = document.getElementById("requestModal");
    const openButtons = document.querySelectorAll(".open-form");
    const closeModal = document.getElementById("closeModal");
    const cancelModal = document.getElementById("cancelModal");
    const modalTitle = document.getElementById("modalTitle");
    const interestClicked = document.getElementById("interestClicked");
    const programSelect = document.getElementById("program");
    const paymentPlanToggle = document.getElementById("paymentPlanToggle");
    const paymentPlanPanel = document.getElementById("paymentPlanPanel");

    function openRequestModal(interest) {
      const chosenInterest = interest || "General July Program Request";
      interestClicked.value = chosenInterest;
      modalTitle.textContent = chosenInterest;

      const options = Array.from(programSelect.options);
      const match = options.find(option => option.textContent.includes(chosenInterest) || option.value.includes(chosenInterest));

      if (match) {
        programSelect.value = match.value;
      } else if (chosenInterest.includes("Payment Plan")) {
        programSelect.value = "Payment Plan Request";
      }

      if (chosenInterest.includes("Payment Plan")) {
        paymentPlanToggle.checked = true;
        paymentPlanPanel.classList.add("show");
      }

      modal.classList.add("active");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeRequestModal() {
      modal.classList.remove("active");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    openButtons.forEach(button => {
      button.addEventListener("click", () => openRequestModal(button.dataset.interest));
    });

    closeModal.addEventListener("click", closeRequestModal);
    cancelModal.addEventListener("click", closeRequestModal);

    modal.addEventListener("click", event => {
      if (event.target === modal) closeRequestModal();
    });

    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && modal.classList.contains("active")) closeRequestModal();
    });

    paymentPlanToggle.addEventListener("change", () => {
      paymentPlanPanel.classList.toggle("show", paymentPlanToggle.checked);
      if (paymentPlanToggle.checked && programSelect.value === "") {
        programSelect.value = "Payment Plan Request";
      }
    });

    programSelect.addEventListener("change", () => {
      if (programSelect.value === "Payment Plan Request") {
        paymentPlanToggle.checked = true;
        paymentPlanPanel.classList.add("show");
      }
    });
  </script>
</body>
</html>
